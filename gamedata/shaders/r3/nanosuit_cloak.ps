//====================================================================================================================//
//                                                                                                                    //
//     Original Author(s) : NLTP_ASHES                                                                                //
//     Edited : N/A                                                                                                   //
//     Date : 30/09/2026                                                                                              //
//     License : Public Domain Mark 1.0 Universal                                                                     //
//                                                                                                                    //
//     Pixel shader for the Nanosuit cloak mode.                                                                      //
//                                                                                                                    //
//     This is Crysis's own cloak, CloakLayer.cfx, ported. Crysis draws it as a material layer in two passes over     //
//     the same geometry : p0 (CloakRefrationPS) alpha blends a refraction of the scene behind the suit, p1           //
//     (CloakSparksPS) adds electric sparks on top. Strict-sorted geometry only ever draws its first pass here,       //
//     and HUD geometry is strict-sorted, so both are folded into one : p1 adds on top of p0's blended result,        //
//     final = p0 * a + dest * (1 - a) + sparks, which is exactly what p0's blend gives when the shader outputs       //
//     p0 + sparks / a. The alpha never drops below 0.5, so the division is safe.                                     //
//                                                                                                                    //
//     The scene is $user$generic_temp, the copy the engine takes of rt_Generic_0 right before the forward phase,     //
//     which is where Crysis reads $SceneTarget from. The suit is not in it, since it is forward only, so "dest"      //
//     is the background as well : the base layer is not drawn while cloaked, and the 0.5 floor on the alpha only     //
//     mixes a refracted view of the background with a straight one, along the hex net.                               //
//                                                                                                                    //
//     Crysis runs this in linear HDR, and here the forward phase is after the tonemap and the gamma, in LDR. The     //
//     refraction is a pass-through either way, but the additive terms are not : the nano rim and the sparks are      //
//     small linear values that the gamma curve lifts a lot, 0.02 displays as about 0.17. Added to the gamma          //
//     encoded image as they are, the rim that outlines the silhouette and the sparks that keep crackling once        //
//     the cloak settles all but vanish. So the refracted colour is decoded to linear (gamma 2.2), everything is      //
//     added there, and the sum encoded back. The alpha blend itself stays in gamma space. PS_HDR_RANGE_ADAPT_MAX     //
//     is taken as 1, and the additive terms clip at 1 instead of blooming.                                           //
//                                                                                                                    //
//     This pairs with whichever deffer_model_bump-hq.vs is installed, for the same reason the glow does : reading    //
//     p_bumped and nothing else keeps it working on top of Screen Space Shaders, TAA jitter included. Everything     //
//     Crysis passes down from its vertex shader is recovered here instead : world and object space positions by      //
//     undoing m_WV, the refraction strength from the bus.                                                            //
//                                                                                                                    //
//     Driven by the "nanosuit_cloak" shader bus lane, laid out like Crysis's PI_CloakParams[0] :                     //
//       x : refraction falloff, 1 for full strength                                                                  //
//       y : unused, Crysis's sparks alpha                                                                            //
//       z : light amount, how much light reaches the suit                                                            //
//       w : cloak blend, 0 uncloaked, 1 fully cloaked                                                                //
//                                                                                                                    //
//     The sparks alpha is a constant here. Remastered computes its own in the encrypted executable, and the          //
//     original 2007 CloakLayer.cfx drives it from screen motion and a transition curve that settle to under 10%.     //
//     Held at a fixed level instead, the three palette peaks sweeping through the noise still only line up now       //
//     and then, which is the occasional crackle Crysis shows while cloaked. Tuned by eye in game.                    //
//                                                                                                                    //
//     The light amount is X-Ray's, on its unit scale. Crysis's is HDR, its daylight sun is its colour times 3.34,    //
//     so the sparks scale it by 3 to crackle as they do there. The nano layer does not : it adds the light           //
//     across whole faces seen at a glancing angle, and at 3 times it filled the hex cells with a flat grey.          //
//                                                                                                                    //
//     The refracted scene is tinted a faint purple, which Crysis's is not. It comes from the addon's previous        //
//     cloak shader, which scaled the scene by (0.955, 0.95, 1.1), toned down here. It is applied in gamma space as   //
//     that one did, and follows the cloak blend.                                                                     //
//                                                                                                                    //
//====================================================================================================================//

#include "common.h"

#ifdef USE_MSAA
    #ifndef SM_5
        Texture2DMS<float4, MSAA_SAMPLES> s_cloak_scene; // Scene behind the suit, $user$generic_temp
    #else
        Texture2DMS<float4> s_cloak_scene;
    #endif
#else
    Texture2D s_cloak_scene;
#endif

Texture2D s_cloak_hex;                                 // Crysis hex_ddn.dds, the nano net
Texture2D s_cloak_perlin;                              // Crysis perlinNoise_sum.dds
Texture2D s_cloak_noise;                               // Crysis Noise3D.dds, flattened to an atlas
Texture2D s_cloak_sparks;                              // Crysis palette/cloak_sparks.dds

uniform float4 bus_nanosuit_cloak;                     // Shader bus lane

static const float  CLOAK_REFR_BUMP_SCALE      = 1.00f;  // RefrBumpScale, the same 1 in every Crysis material
static const float  CLOAK_SPARKS_TILLING       = 1.00f;  // SparksTilling, the same
static const float  CLOAK_NANOMASK_OFFSET      = 0.00f;  // PI_CloakParams[1].x. Anything above 0 fades the hex net
static const float  CLOAK_NANO_TILLING         = 30.00f; // Hex net repeats per uv unit
static const float  CLOAK_NANO_LAYER_EXP       = 16.00f; // The higher, the more the nano layer hugs the silhouette
static const float  CLOAK_NANO_LAYER_INTENSITY = 0.25f;
static const float  CLOAK_NANO_COLOR_AMOUNT    = 0.33f;
static const float3 CLOAK_NANO_COLOR           = float3(0.20f, 0.40f, 1.00f);
static const float3 CLOAK_SPARKS_COLOR         = float3(0.23f, 0.20f, 1.00f);
static const float  CLOAK_SPARKS_NOISE_SCALE   = 1.50f;
static const float  CLOAK_SPARKS_ALPHA         = 0.80f;  // Not Crysis's, see above
static const float  CLOAK_SPARKS_LIGHT_SCALE   = 3.00f;  // X-Ray's unit scale light to Crysis's HDR, for the sparks only
static const float  CLOAK_SPARKS_SPEED         = 0.50f;  // How fast the sparks crawl. Crysis's is 0.8, slowed by eye
static const float4 CLOAK_CA_OFFSETS           = float4(0.040f, 0.030f, 0.015f, 0.000f);
static const float  CLOAK_AVG_OFFSET           = 0.83f;  // Pixels. Crysis's 1.66 * PS_ScreenSize.zw, a half texel
static const float  CLOAK_TIME_SCALE           = 0.40f;  // Crysis samples the clock as PB_time 0.4
static const float  CLOAK_GAMMA                = 2.20f;  // The forward target holds gamma encoded colour
static const float3 CLOAK_TINT                 = float3(0.970f, 0.965f, 1.070f); // Not Crysis's, see above

static const float  CLOAK_NOISE_SIZE           = 128.0f; // Noise3D is 128^3
static const float  CLOAK_NOISE_TILE           = 130.0f; // Each slice padded by one texel wrapped from the far edge
static const float2 CLOAK_NOISE_GRID           = float2(16.0f, 8.0f);

float3 cloak_scene(float2 tc)
{
#ifdef USE_MSAA
    int2 texel = int2(min(saturate(tc) * screen_res.xy, screen_res.xy - 1.0f));
    return s_cloak_scene.Load(texel, 0).rgb;
#else
    return s_cloak_scene.SampleLevel(smp_nofilter, tc, 0).rgb;
#endif
}

float2 cloak_noise_tc(float2 texel, float slice)
{
    float2 tile = float2(fmod(slice, CLOAK_NOISE_GRID.x), floor(slice / CLOAK_NOISE_GRID.x));

    return (tile * CLOAK_NOISE_TILE + 1.0f + texel) / (CLOAK_NOISE_TILE * CLOAK_NOISE_GRID);
}

// tex3D with wrap addressing and trilinear filtering, over the atlas. The padding does the filtering within a
// slice, and the two slices around the sample are blended here.
float cloak_noise(float3 uvw)
{
    float3 texel = frac(uvw) * CLOAK_NOISE_SIZE;

    float slice = texel.z - 0.5f;
    float z0 = floor(slice);
    float fz = slice - z0;
    float z1 = z0 + 1.0f;

    z0 = (z0 < 0.0f) ? CLOAK_NOISE_SIZE - 1.0f : z0;
    z1 = (z1 >= CLOAK_NOISE_SIZE) ? 0.0f : z1;

    float n0 = s_cloak_noise.SampleLevel(smp_linear, cloak_noise_tc(texel.xy, z0), 0).r;
    float n1 = s_cloak_noise.SampleLevel(smp_linear, cloak_noise_tc(texel.xy, z1), 0).r;

    return lerp(n0, n1, fz);
}

// Where a view space point lands on the screen. p_bumped carries no SV_Position, and adding one would change the
// signature the installed vertex shader links against. m_P is the HUD projection while HUD geometry draws.
float2 cloak_screen_tc(float3 pos_e)
{
    float4 pos_p = mul(m_P, float4(pos_e, 1.0f));

    return pos_p.xy / pos_p.w * float2(0.5f, -0.5f) + 0.5f;
}

// Where this pixel sits in model space, which is skinned object space for a character : Crysis's vPosOS.
float3 cloak_model_pos(float3 pos_e)
{
    float3 d = pos_e - float3(m_WV[0].w, m_WV[1].w, m_WV[2].w);

    return float3(dot(d, float3(m_WV[0].x, m_WV[1].x, m_WV[2].x)),
                  dot(d, float3(m_WV[0].y, m_WV[1].y, m_WV[2].y)),
                  dot(d, float3(m_WV[0].z, m_WV[1].z, m_WV[2].z)));
}

float4 main(p_bumped I) : SV_Target
{
    float refr_falloff = bus_nanosuit_cloak.x;
    float light_amount = bus_nanosuit_cloak.z;
    float cloak_blend  = saturate(bus_nanosuit_cloak.w);

    float2 tc = I.tcdh.xy;
    float2 screen_tc = cloak_screen_tc(I.position.xyz);
    float  time = timers.x * CLOAK_TIME_SCALE;
    float  random = frac(sin(timers.x * 12.9898f) * 43758.5453f); // PB_RandomParams : a new value every frame

    // Normal, as GetNormalMap gives it
    float4 Nu  = s_bump.Sample (smp_base, tc);          // normal.gloss
    float4 NuE = s_bumpX.Sample(smp_base, tc);          // normal_error.height
    float3 nrm_t = normalize(Nu.wzy + (NuE.xyz - 1.0f));

    float3 nrm_e = normalize(mul(float3x3(I.M1, I.M2, I.M3), nrm_t));
    float3 eye_e = normalize(-I.position.xyz);

    float n_dot_e = dot(eye_e, nrm_e);
    float n_dot_e_abs = abs(n_dot_e);
    n_dot_e = saturate(n_dot_e);

    // -----------------------------------------------------------------------------------------------------------------
    // Pass p0, CloakRefrationPS
    // -----------------------------------------------------------------------------------------------------------------

    // Strong while the cloak engages, settling to a quarter of the bump scale
    float refr_amount = (0.25f + 2.5f * (1.0f - cloak_blend)) * CLOAK_REFR_BUMP_SCALE * refr_falloff;

    float mask_variation = saturate(s_cloak_perlin.Sample(smp_linear, tc * 0.5f + time * 0.25f).x * 2.0f - 1.0f);

    float2 nano = -(s_cloak_hex.Sample(smp_linear, tc * CLOAK_NANO_TILLING).xy * 2.0f - 1.0f) * cloak_blend * 2.0f;
    float  nano_mask = saturate(saturate(1.0f - 100.0f * dot(nano, nano)) + CLOAK_NANOMASK_OFFSET);

    // Scanlines, 4 pixels apart, jumping every frame
    float  scanline = abs(frac((screen_tc.y + random) * screen_res.y * 0.25f) * 2.0f - 1.0f);
    float2 interlation = scanline * 0.1f + 0.9f;
    interlation -= nano * (1.0f - nano_mask);

    // Refraction, with an index of 1, projected back to the screen
    float3 refr_dir = -2.0f * n_dot_e * nrm_e + eye_e;
    float2 refr_tc = cloak_screen_tc(I.position.xyz + 0.4f * refr_dir * 0.05f * refr_amount * interlation.x);

    // Four taps : a slight blur while engaging, chromatic aberration around the screen center once settled
    float  ca_scale = pow(cloak_blend, 32.0f);
    float4 ca_offsets = lerp(0.0f, CLOAK_CA_OFFSETS, ca_scale);
    float2 avg_offsets = lerp(screen_res.zw * CLOAK_AVG_OFFSET, 0.0f, ca_scale);

    float2 refr_center = refr_tc - 0.5f;
    float3 refr_x = cloak_scene(refr_center * (1.0f - ca_offsets.x) + 0.5f + avg_offsets);
    float3 refr_y = cloak_scene(refr_center * (1.0f - ca_offsets.y) + 0.5f - avg_offsets);
    float3 refr_z = cloak_scene(refr_center * (1.0f - ca_offsets.z) + 0.5f + float2(avg_offsets.x, -avg_offsets.y));
    float3 refr_w = cloak_scene(refr_center * (1.0f - ca_offsets.w) + 0.5f + float2(-avg_offsets.x, avg_offsets.y));

    float3 refr_ca = float3(refr_x.r, refr_y.g, refr_z.b);
    float3 refr_avg = (refr_x + refr_y + refr_z + refr_w) * 0.25f;
    float3 refr_gamma = lerp(refr_avg, refr_ca, saturate(ca_scale));
    refr_gamma *= lerp(float3(1.0f, 1.0f, 1.0f), CLOAK_TINT, cloak_blend);
    float3 refr_color = pow(max(refr_gamma, 0.0f), CLOAK_GAMMA); // Linear, as Crysis reads it

    // The nano layer, a faint blue rim along the silhouette. The light amount comes in at 20%, as in CloakVS.
    // The rim reads |NdotE| rather than Crysis's saturated NdotE, so a normal pointing away does not fill the face
    float  gradient = interlation.y * saturate(1.0f - n_dot_e_abs);
    float3 cloak = dot(refr_color, 0.5f / 3.0f) + light_amount * 0.2f * 0.5f;
    cloak *= gradient * lerp(float3(1.0f, 1.0f, 1.0f), CLOAK_NANO_COLOR, CLOAK_NANO_COLOR_AMOUNT);

    float  has_nano = (nano_mask > 0.0f) ? 1.0f : 0.0f;
    float3 nano_layer = mask_variation * has_nano * cloak
                      * pow(saturate(1.0f - n_dot_e_abs), CLOAK_NANO_LAYER_EXP) * CLOAK_NANO_LAYER_INTENSITY;

    float alpha = 0.5f + nano_mask * cloak_blend * 0.5f;

    // -----------------------------------------------------------------------------------------------------------------
    // Pass p1, CloakSparksPS
    // -----------------------------------------------------------------------------------------------------------------

    float3 pos_m = cloak_model_pos(I.position.xyz);
    float3 pos_w = mul(m_inv_V, float4(I.position.xyz, 1.0f));

    float3 sparks_variation = frac(time) * 0.2f + nrm_t * 0.02f;
    float  sparks_noise = cloak_noise((pos_m * CLOAK_SPARKS_TILLING + sparks_variation) * CLOAK_SPARKS_NOISE_SCALE);

    // Three peaks in the palette sweep through the noise at three rates, the second one shifted by the distance to
    // the world origin so that no two suits spark in step
    float  sparks_timer = time * CLOAK_SPARKS_SPEED;
    float3 sparks = float3(
        s_cloak_sparks.Sample(smp_linear, float2(sparks_noise         + sparks_timer        + 0.1f, 0.5f)).x,
        s_cloak_sparks.Sample(smp_linear, float2(sparks_noise * 1.53f + sparks_timer * 2.0f + 0.4f
                                               + length(pos_w) * 0.1f,                              0.5f)).y,
        s_cloak_sparks.Sample(smp_linear, float2(sparks_noise * 1.70f + sparks_timer * 1.4f + 0.2f, 0.5f)).z);

    sparks = CLOAK_SPARKS_COLOR * dot(sparks, 1.0f);
    sparks *= sparks;
    sparks *= scanline * CLOAK_SPARKS_ALPHA * light_amount * CLOAK_SPARKS_LIGHT_SCALE;

    // Out
    float3 color = pow(saturate(refr_color + nano_layer + sparks / alpha), 1.0f / CLOAK_GAMMA);
    return float4(color.r, color.g, color.b, alpha);
}
