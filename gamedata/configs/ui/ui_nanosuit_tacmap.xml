<!--    UI template for the Nanosuit tactical map.                                                                   -->
<!--                                                                                                                 -->
<!--=================================================================================================================-->
<w>
    <!-- Background -->
    <background x="10" y="563" width="249" height="195" stretch="1">
        <texture a="200">ui_nanosuit_tacmap_bg</texture>
    </background>

    <!-- Outline -->
    <outline x="10" y="563" width="249" height="195" stretch="1">
        <texture a="200">ui_nanosuit_tacmap_outline</texture>
    </outline>

    <!-- Map -->
    <map x="10" y="563" width="249" height="195" stretch="1">
        <texture a="100">ui_nanosuit_tacmap_map</texture>
    </map>

    <!-- Visibility -->
    <visibility_bar_background x="54" y="597" width="12" height="85" stretch="1">
        <texture a="200">ui_nanosuit_tacmap_visibility_bar</texture>
    </visibility_bar_background>
    <visibility_bar x="54" y="597" width="12" height="85" mode="vert" min="0" max="100" pos="100">
        <progress stretch="1">
            <texture>ui_nanosuit_tacmap_visibility_bar</texture>
        </progress>
    </visibility_bar>

    <!-- Object icon -->
    <icon x="10" y="563" width="10" height="10" stretch="1" align="c" heading="1" heading_angle="0" />
</w>
