<!--    UI template for the Nanosuit status hub.                                                                     -->
<!--                                                                                                                 -->
<!--=================================================================================================================-->
<w>
    <!-- Background -->
    <background x="768" y="618" width="246" height="140" stretch="1">
        <texture a="200">ui_nanosuit_status_background</texture>
    </background>

    <!-- Outline -->
    <outline x="768" y="618" width="246" height="140" stretch="1">
        <texture a="200">ui_nanosuit_status_outline</texture>
    </outline>

    <!-- Current suit mode -->
    <suit_mode x="951" y="695" width="50" height="50" stretch="1" />

    <!-- Energy -->
    <energy x="895" y="681" width="50" height="16" stretch="1">
        <text complex_mode="1" r="129" g="183" b="135" align="c" vert_align="c" font="letterica16"/>
    </energy>
    <energy_icon x="882" y="684" width="15" height="12" stretch="1">
        <texture>ui_nanosuit_status_energy_icon</texture>
    </energy_icon>
    <energy_bar_background x="779" y="679" width="122" height="16" stretch="1">
        <texture a="200">ui_nanosuit_status_energy_bar</texture>
    </energy_bar_background>
    <energy_bar x="779" y="679" width="122" height="16" mode="back" min="0" max="100" pos="100">
        <progress stretch="1">
            <texture>ui_nanosuit_status_energy_bar</texture>
        </progress>
    </energy_bar>

    <!-- Health -->
    <health x="895" y="694" width="50" height="16" stretch="1">
        <text complex_mode="1" r="129" g="183" b="135" align="c" vert_align="c" font="letterica16"/>
    </health>
    <health_icon x="882" y="697" width="15" height="12" stretch="1">
        <texture>ui_nanosuit_status_health_icon</texture>
    </health_icon>
    <health_bar_background x="779" y="692" width="122" height="16" stretch="1">
        <texture a="200">ui_nanosuit_status_health_bar</texture>
    </health_bar_background>
    <health_bar x="779" y="692" width="122" height="16" mode="back" min="0" max="100" pos="100">
        <progress stretch="1">
            <texture>ui_nanosuit_status_health_bar</texture>
        </progress>
    </health_bar>

    <!-- Stamina -->
    <stamina x="895" y="707" width="50" height="16" stretch="1">
        <text complex_mode="1" r="129" g="183" b="135" align="c" vert_align="c" font="letterica16"/>
    </stamina>
    <stamina_icon x="882" y="710" width="15" height="12" stretch="1">
        <texture>ui_nanosuit_status_stamina_icon</texture>
    </stamina_icon>
    <stamina_bar_background x="779" y="705" width="122" height="16" stretch="1">
        <texture a="200">ui_nanosuit_status_stamina_bar</texture>
    </stamina_bar_background>
    <stamina_bar x="779" y="705" width="122" height="16" mode="back" min="0" max="100" pos="100">
        <progress stretch="1">
            <texture>ui_nanosuit_status_stamina_bar</texture>
        </progress>
    </stamina_bar>

    <!-- Ammo -->
    <ammo_count x="820" y="613" width="100" height="40" stretch="1">
        <text complex_mode="1" r="129" g="183" b="135" align="c" vert_align="c" font="letterica25"/>
    </ammo_count>

    <ammo_reserve x="883" y="620" width="50" height="20" stretch="1">
        <text complex_mode="1" r="129" g="183" b="135" align="c" vert_align="c" font="letterica16"/>
    </ammo_reserve>

    <!-- Fire mode -->
    <fire_mode x="935" y="624" width="25" height="25" stretch="1" />
</w>
