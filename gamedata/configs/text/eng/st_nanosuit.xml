    <string id="st_nanosuit_defibrillator">
        <text>Nanosuit defibrillator powerbank</text>
    </string>

    <string id="st_nanosuit_defibrillator_s">
        <text>Powerbank</text>
    </string>

    <string id="st_nanosuit_defibrillator_descr">
        <text>This powerbank is a compact, high-capacity energy storage device designed to power the nanosuit's built-in defibrillator system. It allows the user to revive themselves, providing a critical advantage in combat situations. The powerbank is single use, and must be replaced after use.\n \n</text>
    </string>

