---==================================================================================================================---

-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- ---------------------------------------------------------------------------------------------------------------------
-- Companion wheel UI class
-- ---------------------------------------------------------------------------------------------------------------------

class "ui_wheel_companion" (CUIScriptWnd)

function ui_wheel_companion:__init(parent) super()
    -- Variables
    self.m_parent = parent

    -- Initialize companion wheel if needed
    if not axr_companions.GUI then
        axr_companions.GUI = axr_companions.UIWheelCompanion()
    end

    -- Override wheel background
    axr_companions.GUI.background = axr_companions.GUI.dialog:FindChild("wheel_background"):cast_Static()
    axr_companions.GUI.background:InitTexture("ui_nanosuit_wheel_background")
    axr_companions.GUI.background:SetTextureColor(GetARGB(200, 255, 255, 255))

    -- Create wheel outline
    axr_companions.GUI.outline = axr_companions.GUI.xml:InitStatic("wheel:background", axr_companions.GUI.dialog)
    axr_companions.GUI.outline:InitTexture("ui_nanosuit_wheel_outline")

    -- Override info box background
    axr_companions.GUI.info_background = axr_companions.GUI.dialog_info:FindChild("info_background"):cast_Static()
    axr_companions.GUI.info_background:InitTexture("ui_nanosuit_wheel_info_background")
    axr_companions.GUI.info_background:SetTextureColor(GetARGB(200, 255, 255, 255))

    -- Create info box outline
    axr_companions.GUI.info_outline = axr_companions.GUI.xml:InitStatic("info:background", axr_companions.GUI.dialog_info)
    axr_companions.GUI.info_outline:InitTexture("ui_nanosuit_wheel_info_outline")
end

function ui_wheel_companion:destroy()
    -- Destroy wheel outline
    axr_companions.GUI.dialog:DetachChild(axr_companions.GUI.outline)
    axr_companions.GUI.outline = nil

    -- Destroy info outline
    axr_companions.GUI.dialog_info:DetachChild(axr_companions.GUI.info_outline)
    axr_companions.GUI.info_outline = nil

    -- Reset UI
    axr_companions.GUI:InitControls()
end

function ui_wheel_companion:Update(force)
    CUIScriptWnd.Update(self)

    if self.m_parent.m_core.m_malfunctor.m_enabled then
        axr_companions.GUI.outline:SetTextureColor(self.m_parent.m_colors.red)
        axr_companions.GUI.info_outline:SetTextureColor(self.m_parent.m_colors.red)
    else
        axr_companions.GUI.outline:SetTextureColor(self.m_parent.m_colors.background)
        axr_companions.GUI.info_outline:SetTextureColor(self.m_parent.m_colors.background)
    end
end
