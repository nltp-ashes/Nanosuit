-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

VIGNETTE_EDG = 1 - (1 / math.sqrt(2))

LINES_SLICES = { "top", "bottom", "left", "right", "frame_top", "frame_bottom", "reticle" }
TEXT_SLICES = { "left", "right" }

-- ---------------------------------------------------------------------------------------------------------------------
-- Binoculars UI class
-- ---------------------------------------------------------------------------------------------------------------------

class "ui_binoculars" (CUIScriptWnd)

function ui_binoculars:__init(parent) super()
    -- Variables
    self.m_parent = parent
    self.m_is_active = false

    -- Build UI
    self.m_xml = CScriptXmlInit()
    self.m_xml:ParseFile("ui_nanosuit_binoculars.xml")

    self.m_ui_lines = {}
    for _, name in ipairs(LINES_SLICES) do
        self.m_ui_lines[name] = self.m_xml:InitStatic("lines:" .. name, self)
        self.m_ui_lines[name]:SetTextureColor(self.m_parent.m_theme.shared.outline)
    end

    self.m_ui_text = {}
    for _, name in ipairs(TEXT_SLICES) do
        self.m_ui_text[name] = self.m_xml:InitStatic("text:" .. name, self)
        self.m_ui_text[name]:SetTextureColor(self.m_parent.m_theme.shared.text)
    end

    self.m_ui_mode = self.m_xml:InitStatic("mode", self)

    self.m_ui_mode_label = self.m_xml:InitTextWnd("mode:label", self.m_ui_mode)
    self.m_ui_mode_label:SetTextColor(self.m_parent.m_theme.shared.text)
    self.m_ui_mode_label:SetText(game.translate_string("st_nanosuit_binoculars_mode"))

    self.m_ui_mode_value = self.m_xml:InitTextWnd("mode:value", self.m_ui_mode)
    self.m_ui_mode_value:SetTextColor(self.m_parent.m_theme.shared.text)

    self.m_ui_zoom = self.m_xml:InitStatic("zoom", self)

    self.m_ui_zoom_label = self.m_xml:InitTextWnd("zoom:label", self.m_ui_zoom)
    self.m_ui_zoom_label:SetTextColor(self.m_parent.m_theme.shared.text)
    self.m_ui_zoom_label:SetText(game.translate_string("st_nanosuit_binoculars_zoom"))

    self.m_ui_zoom_value = self.m_xml:InitTextWnd("zoom:value", self.m_ui_zoom)
    self.m_ui_zoom_value:SetTextColor(self.m_parent.m_theme.shared.text)

    self.m_ui_range = self.m_xml:InitTextWnd("range", self)
    self.m_ui_range:SetTextColor(self.m_parent.m_theme.shared.text)

    self.m_ui_coordinates = self.m_xml:InitStatic("coordinates", self)

    self.m_ui_coordinates_n = self.m_xml:InitTextWnd("coordinates:north", self.m_ui_coordinates)
    self.m_ui_coordinates_n:SetTextColor(self.m_parent.m_theme.shared.text)

    self.m_ui_coordinates_w = self.m_xml:InitTextWnd("coordinates:west", self.m_ui_coordinates)
    self.m_ui_coordinates_w:SetTextColor(self.m_parent.m_theme.shared.text)

    self:show_overlay(false)
end

function ui_binoculars:__finalize()
end

function ui_binoculars:destroy()
end

function ui_binoculars:Update(force)
    CUIScriptWnd.Update(self)

    if not self.m_is_active and self.m_parent.m_core.m_binoculars.m_is_active then
        self:activate()
    elseif self.m_is_active and not self.m_parent.m_core.m_binoculars.m_is_active then
        self:deactivate()
    end

    local mode = self:get_mode()
    self.m_ui_mode_value:SetText(mode)

    local zoom = self:get_zoom() -- zoom = 2 -> display X02, zoom = 16 -> display X16
    self.m_ui_zoom_value:SetText("X" .. string.format("%02d", zoom))

    local range = self:get_range()
    self.m_ui_range:SetText(tostring(range) .. "M")

    local coordinates = self:get_coordinates()
    self.m_ui_coordinates_n:SetText(tostring(coordinates.y) .. "N")
    self.m_ui_coordinates_w:SetText(tostring(coordinates.x) .. "W")
end

function ui_binoculars:activate()
    self:show_overlay(true)
end

function ui_binoculars:deactivate()
    self:show_overlay(false)
end

function ui_binoculars:show_overlay(visible)
    self.m_is_active = visible

    -- FIXME : This shader doesn't work, don't know why
    -- local vignette_power = visible and 1 or 0
    -- exec_console_cmd(string.format("vignette_control %s,0.0,%s,0.0", vignette_power, VIGNETTE_EDG))

    for _, slice in pairs(self.m_ui_lines) do
        slice:Show(visible)
    end

    for _, slice in pairs(self.m_ui_text) do
        slice:Show(visible)
    end

    self.m_ui_mode:Show(visible)
    self.m_ui_zoom:Show(visible)
    self.m_ui_range:Show(visible)
    self.m_ui_coordinates:Show(visible)
end

function ui_binoculars:get_mode()
    if self.m_parent.m_core.m_nightvision:is_active() or item_device.is_nv_active() then
        return "NV"
    end
    return "VIS"
end

function ui_binoculars:get_zoom()
    local binocs = self.m_parent.m_core.m_binoculars
    return binocs.m_fov_factor_steps[binocs.m_fov_factor_idx]
end

function ui_binoculars:get_range()
    return math.floor(level.get_target_dist())
end

function ui_binoculars:get_coordinates()
    local pos = db.actor:position()
    return vector2():set(math.floor(pos.x), math.floor(pos.z))
end
