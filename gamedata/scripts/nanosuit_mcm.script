                    { type = "title", text = "ui_mcm_menu_nanosuit_general" },
                    { type = "check", val = mcm_types_enum.boolean, id = "use_witness", def = defaults["use_witness"] },
                    { type = "list", val = mcm_types_enum.string, id = "suit_gender", def = defaults["suit_gender"], no_str = true, content = { {gender_enum.male,"ui_mcm_nanosuit_nanosuit_general_suit_gender_lst_male"}, {gender_enum.female,"ui_mcm_nanosuit_nanosuit_general_suit_gender_lst_female"} } },
