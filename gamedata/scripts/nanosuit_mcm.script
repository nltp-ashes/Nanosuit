-- ---------------------------------------------------------------------------------------------------------------------
-- General functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to get a color constant based on the currently equipped outfit.
--- @param key string
--- @param default any
--- @return any
function get_outfit_color_config(key, default)
    local res = get_outfit_config(key, default)
    res = str_explode(res, ",")
    return GetARGB(res[1], res[2], res[3], res[4])
end

--- Function used to get a configuration constant based on the currently equipped outfit.
--- @param key string
--- @param default any
--- @return any
function get_outfit_config(key, default)
    local outfit = db.actor:item_in_slot(actor_slots_enum.outfit)
    if not outfit then
        return default
    end
    return get_config("configuration", outfit:section() .. "/" .. key, default)
end

--- Function used to get a given setting defined in MCM.
--- If MCM isn't installed, it will default back to a value in defaults table.
--- @param key string
--- @return any
function get_config(category, key, default)
    if ui_mcm then
        return ui_mcm.get("nanosuit/nanosuit_" .. category .. "/" .. key) or default
    end
    return defaults[key] or default
end

--- MCM UI definition.
--- @return table
