-- ---------------------------------------------------------------------------------------------------------------------
-- General functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to get a given setting defined in MCM.
--- If MCM isn't installed, it will default back to a value in defaults table.
--- @param key string
--- @return any
function get_config(category, key)
    if ui_mcm then
        return ui_mcm.get("nanosuit/nanosuit_" .. category .. "/" .. key)
    end
    return defaults[key]
end

--- Function used to get a color constant based on the currently equipped outfit.
--- @param short_key string
--- @param default any
--- @return any
function get_constant_color(short_key, default)
    local res = get_constant(short_key, default)
    res = str_explode(res, ",")
    return GetARGB(res[1], res[2], res[3], res[4])
end

--- Function used to get a configuration constant based on the currently equipped outfit.
--- @param short_key string
--- @param default any
--- @return any
function get_constant(short_key, default)
    local outfit = db.actor:item_in_slot(actor_slots_enum.outfit)
    local section = outfit and outfit:section()
    if not section then
        return default
    end
    local key = section .. "/" .. short_key
    if ui_mcm then
        return ui_mcm.get("nanosuit/nanosuit_configuration/" .. key) or default
    end
    return defaults[key] or default
end

