-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- Imports
armor_modes_enum                    = nanosuit_utils.armor_modes_enum

-- Constants
pulse_anomaly_malfunction_dist_sqr  = 50 ^ 2
psi_storm_malfunction_dist_sqr      = 150 ^ 2

-- ---------------------------------------------------------------------------------------------------------------------
-- General functions
-- ---------------------------------------------------------------------------------------------------------------------

bind_anomaly_field_pulse_anomaly_hit = bind_anomaly_field.pulse_anomaly_hit
bind_anomaly_field.pulse_anomaly_hit = function(particle_pos)
    local ret = bind_anomaly_field_pulse_anomaly_hit(particle_pos)

    local instance = nanosuit_core.get_instance() and nanosuit_core.get_instance().m_malfunctor
    local is_in_range = distance_2d_sqr(db.actor:position(), particle_pos) <= pulse_anomaly_malfunction_dist_sqr
    if instance and is_in_range then
        instance:enable_malfunction(false)
    end

    return ret
end

psi_storm_manager_CPsiStormManager_vortex_actor_hit = psi_storm_manager.CPsiStormManager.vortex_actor_hit
psi_storm_manager.CPsiStormManager.vortex_actor_hit = function(self, vortex)
    local ret = psi_storm_manager_CPsiStormManager_vortex_actor_hit(self, vortex)

    local instance = nanosuit_core.get_instance() and nanosuit_core.get_instance().m_malfunctor
    local is_in_range = distance_2d_sqr(db.actor:position(), vortex.particle_pos) <= psi_storm_malfunction_dist_sqr
    if instance and is_in_range then
        instance:enable_malfunction(false)
    end

    return ret
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Malfunction class
-- ---------------------------------------------------------------------------------------------------------------------

class "malfunctor"

function malfunctor:__init(core)
    self.m_core = core

    -- Constants
    self.m_anomaly_hit_duration = 20

    -- Variables
    self.m_enabled = false
    self.m_stay_off = false

    -- Register callbacks
    RegisterScriptCallback("actor_on_death", self)
end

function malfunctor:destroy()
    self.m_core = nil

    -- Unregister callbacks
    UnregisterScriptCallback("actor_on_death", self)
end

function malfunctor:save()
    return {
        enabled = self.m_enabled,
        stay_off = self.m_stay_off
    }
end

function malfunctor:load(m_data)
    self.m_stay_off = m_data.stay_off or false

    if m_data.enabled then
        self:enable_malfunction(m_data.stay_off)
    end
end

function malfunctor:enable_malfunction(stay_off)
    if not self.m_enabled then
        self.m_enabled = true
        self.m_stay_off = stay_off or false

        self.m_core:change_mode(armor_modes_enum.armor, false)
        self.m_core:use_energy(100)

        if self.m_core.m_energy_off_voiced and not self.m_core.m_sounds.energy_off:playing() then
            self.m_core.m_sounds.energy_off:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d)
        end

        if not self.m_stay_off then
            CreateTimeEvent("nanosuit_malfunction", "disable", self.m_anomaly_hit_duration, function()
                self:disable_malfunction()
                return true
            end)
        end
    elseif not self.m_stay_off then
        ResetTimeEvent("nanosuit_malfunction", "disable", self.m_anomaly_hit_duration)
    end
end

function malfunctor:disable_malfunction()
    if self.m_enabled then
        self.m_enabled = false
        self.m_core:change_mode(self.m_core.m_default_mode, true)
        self.m_core.m_energy_last_use = time_global()
    end
end

function malfunctor:actor_on_death()
    self:enable_malfunction(true)
end
