---                                                                                                                  ---
---    Script used to handle the logic of a cloaking booster usable by a Nanosuit mode.                              ---
---                                                                                                                  ---
---    The booster only decides which items are cloaked : the swapping itself belongs to the core's m_cloak.         ---
---    An item leaving its slot is restored right away. When the booster is removed, its items are handed over       ---
---    instead, so that they fade out with the suit and are restored when the cloak finishes.                        ---
---                                                                                                                  ---
---==================================================================================================================---

-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- Imports
actor_slots_enum        = nanosuit_utils.actor_slots_enum

-- ---------------------------------------------------------------------------------------------------------------------
-- Cloak booster class
-- ---------------------------------------------------------------------------------------------------------------------

class "cloak" (nanosuit_booster.abstract_booster)

function cloak:__init(core, name) super(core, name)
    -- Variables
    self.m_handing_over = false

    -- Cache
    self.m_cache[actor_slots_enum.knife] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.pistol] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.rifle] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.grenade] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.binoculars] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.bolt] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.outfit] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.pda] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.detector] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.torch] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.artefact] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.helmet] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.backpack] = { enabled = true, obj_id = nil }
    self.m_cache[actor_slots_enum.animation] = { enabled = true, obj_id = nil }
end

function cloak:remove()
    self.m_handing_over = true
    nanosuit_booster.abstract_booster.remove(self)
    self.m_handing_over = false
end

function cloak:set(obj, slot)
    nanosuit_booster.abstract_booster.set(self, obj, slot)

    self.m_core.m_cloak:add_object(obj)
end

function cloak:unset(obj, slot)
    if not self.m_handing_over then
        self.m_core.m_cloak:remove_object(obj:id())
    end

    nanosuit_booster.abstract_booster.unset(self, obj, slot)
end
