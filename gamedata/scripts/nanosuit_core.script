-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- Imports
localized_sound_object  = nanosuit_utils.localized_sound_object
actor_slots_enum        = nanosuit_utils.actor_slots_enum
armor_modes_enum        = nanosuit_utils.armor_modes_enum

-- ---------------------------------------------------------------------------------------------------------------------
-- General functions
-- ---------------------------------------------------------------------------------------------------------------------

function bind(obj)
    obj:bind_object(nanosuit_binder(obj))
end

function get_instance()
    local outfit = db.actor:item_in_slot(actor_slots_enum.outfit)
    if not outfit then
        return nil
    end
    local binder = outfit:binded_object()
    if not binder then
        return nil
    end
    return binder.m_instance
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Nanosuit binder class
-- ---------------------------------------------------------------------------------------------------------------------

class "nanosuit_binder" (object_binder)

function nanosuit_binder:__init(obj) super(obj)
    printf("[NS] Binding object %s", obj:name())
    self.m_object = obj
    self.m_instance = nil
    self.m_loaded_storage = nil

    RegisterScriptCallback("actor_item_to_slot", self)
    RegisterScriptCallback("actor_item_to_ruck", self)
    RegisterScriptCallback("actor_on_item_drop", self)
    RegisterScriptCallback("actor_on_net_destroy", self)
end

function nanosuit_binder:net_destroy()
    self:destroy_instance_if_exists()
    self.m_object = nil
    self.m_instance = nil
    self.m_loaded_storage = nil

    UnregisterScriptCallback("actor_item_to_slot", self)
    UnregisterScriptCallback("actor_item_to_ruck", self)
    UnregisterScriptCallback("actor_on_item_drop", self)
    UnregisterScriptCallback("actor_on_net_destroy", self)
end

function nanosuit_binder:save(output_packet)
    object_binder.save(self, output_packet)

    if self.m_instance ~= nil then
        printf("[NS] Nanosuit saving variables")
        se_save_var(self.object:id(), nil, "nanosuit_storage", self.m_instance:save())
        printf("[NS] Nanosuit saved variables")
    end
end

function nanosuit_binder:load(input_packet)
    object_binder.load(self, input_packet)

    printf("[NS] Nanosuit pre-loading variables")
    self.m_loaded_storage = se_load_var(self.object:id(), nil, "nanosuit_storage") or {}
end

function nanosuit_binder:create_instance_if_not_exists()
    if self.m_instance == nil then
        printf("[NS] Nanosuit core initializing")
        self.m_instance = core()
        if self.m_loaded_storage ~= nil then
            printf("[NS] Nanosuit loading variables")
            self.m_instance:load(self.m_loaded_storage)
            self.m_loaded_storage = nil
            printf("[NS] Nanosuit loaded variables")
        end
        printf("[NS] Nanosuit core initialized")
    end
end

function nanosuit_binder:destroy_instance_if_exists()
    if self.m_instance ~= nil then
        printf("[NS] Nanosuit core destroying")
        self.m_instance:destroy()
        self.m_instance = nil
        printf("[NS] Nanosuit core destroyed")
    end
end

function nanosuit_binder:actor_item_to_slot(obj)
    local obj_id = obj:id()
    nextTick(function()
        local obj_now = level.object_by_id(obj_id)
        if obj_now and obj_now:id() == self.m_object:id() then
            self:create_instance_if_not_exists()
        end
        return true
    end)
end

function nanosuit_binder:actor_item_to_ruck(obj)
    local obj_id = obj:id()
    nextTick(function()
        local obj_now = level.object_by_id(obj_id)
        if obj_now and obj_now:id() == self.m_object:id() then
            self:destroy_instance_if_exists()
        end
        return true
    end)
end

function nanosuit_binder:actor_on_item_drop(obj)
    local obj_id = obj:id()
    nextTick(function()
        local obj_now = level.object_by_id(obj_id)
        if obj_now and obj_now:id() == self.m_object:id() then
            self:destroy_instance_if_exists()
        end
        return true
    end)
end

function nanosuit_binder:actor_on_net_destroy()
    self:destroy_instance_if_exists()
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Core class
-- ---------------------------------------------------------------------------------------------------------------------

class "core"

function core:__init()
    -- Constants
    self.m_energy_regen_rate = 100
    self.m_energy_regen_delay = 5000
    self.m_energy_low_threshold = 20
    self.m_energy_very_low_threshold = 10
    self.m_energy_off_threshold = 0
    self.m_energy_on_threshold = 0

    -- Variables
    self.m_energy = 100
    self.m_energy_last_use = 0
    self.m_energy_last_regen = 0
    self.m_energy_low_voiced = true
    self.m_energy_very_low_voiced = true
    self.m_energy_off_voiced = true
    self.m_energy_on_voiced = true

    -- Sound effects
    self.m_sounds = {
        energy_low_voice = localized_sound_object([[nanosuit\voice\energy_low_voice]]),
        energy_very_low = sound_object([[nanosuit\energy\energy_very_low]]),
        energy_on = sound_object([[nanosuit\energy\energy_on]]),
        energy_off = sound_object([[nanosuit\energy\energy_off]])
    }

    -- Armor modes
    self.m_modes = {
        [armor_modes_enum.armor] = nanosuit_mode_armor[armor_modes_enum.armor](self, armor_modes_enum.armor),
        [armor_modes_enum.power] = nanosuit_mode_power[armor_modes_enum.power](self, armor_modes_enum.power),
        [armor_modes_enum.speed] = nanosuit_mode_speed[armor_modes_enum.speed](self, armor_modes_enum.speed),
        [armor_modes_enum.cloak] = nanosuit_mode_cloak[armor_modes_enum.cloak](self, armor_modes_enum.cloak)
    }

    -- Default mode initialization
    self.m_default_mode = armor_modes_enum.armor
    self.m_current_mode = self.m_modes[self.m_default_mode]
    self.m_current_mode:apply(false)

    -- UIs
    self.m_hud = nanosuit_ui_hud.ui_hud(self)

    -- Others
    self.m_vaporizer = nanosuit_vaporizer.vaporizer(self)
    self.m_malfunctor = nanosuit_malfunctor.malfunctor(self)
    self.m_defibrillator = nanosuit_defibrillator.defibrillator(self)

    -- Register callbacks
    RegisterScriptCallback("actor_on_death", self)
    RegisterScriptCallback("actor_on_update", self)
    RegisterScriptCallback("on_option_change", self)
end

function core:__finalize()
    printf("[NS] Nanosuit core garbage collected")
end

function core:destroy()
    self.m_current_mode:remove(true)

    for _, mode in pairs(self.m_modes) do
        mode:destroy()
    end

    UnregisterScriptCallback("actor_on_death", self)
    UnregisterScriptCallback("actor_on_update", self)
    UnregisterScriptCallback("on_option_change", self)

    for _, sfx in pairs(self.m_sounds) do
        if sfx:playing() then
            sfx:stop()
        end
    end

    self.m_hud:destroy()
    self.m_vaporizer:destroy()
    self.m_malfunctor:destroy()
    self.m_defibrillator:destroy()
end

function core:save()
    local storage = {}
    storage.energy = self.m_energy
    storage.energy_low_voiced = self.m_energy_low_voiced
    storage.energy_very_low_voiced = self.m_energy_very_low_voiced
    storage.energy_off_voiced = self.m_energy_off_voiced
    storage.energy_on_voiced = self.m_energy_on_voiced

    storage.modes = {}
    for name, mode in pairs(self.m_modes) do
        storage.modes[name] = mode.save and mode:save() or {}
    end

    storage.vaporizer = self.m_vaporizer.save and self.m_vaporizer:save() or {}
    storage.malfunctor = self.m_malfunctor.save and self.m_malfunctor:save() or {}
    storage.defibrillator = self.m_defibrillator.save and self.m_defibrillator:save() or {}

    return storage
end

function core:load(storage)
    self.m_energy = storage.energy or self.m_energy
    self.m_energy_low_voiced = storage.energy_low_voiced or self.m_energy_low_voiced
    self.m_energy_very_low_voiced = storage.energy_very_low_voiced or self.m_energy_very_low_voiced
    self.m_energy_off_voiced = storage.energy_off_voiced or self.m_energy_off_voiced
    self.m_energy_on_voiced = storage.energy_on_voiced or self.m_energy_on_voiced

    for name, mode in pairs(self.m_modes) do
        if storage.modes and storage.modes[name] and mode.load then
            mode:load(storage.modes[name])
        end
    end

    if storage.vaporizer and self.m_vaporizer.load then
        self.m_vaporizer:load(storage.vaporizer)
    end

    if storage.malfunctor and self.m_malfunctor.load then
        self.m_malfunctor:load(storage.malfunctor)
    end

    if storage.defibrillator and self.m_defibrillator.load then
        self.m_defibrillator:load(storage.defibrillator)
    end
end

function core:use_energy(amount)
    self.m_energy = clamp(self.m_energy - amount, 0, 100)
    self.m_energy_last_use = time_global()
end

function core:change_mode(mode, play_voice)
    if self.m_current_mode ~= self.m_modes[mode] then
        self.m_current_mode:remove(false)
        self.m_current_mode = self.m_modes[mode]
        self.m_current_mode:apply(play_voice)
    end
end

function core:on_option_change()
    self.m_hud:destroy()
    self.m_hud = nanosuit_ui_hud.ui_hud(self)
end

function core:actor_on_death()
    for _, sfx in pairs(self.m_sounds) do
        if sfx:playing() then
            sfx:stop()
        end
    end
end

function core:actor_on_update()
    -- Delay energy regen 5s after last energy use
    if time_global() - self.m_energy_last_use > self.m_energy_regen_delay and not self.m_malfunctor.m_enabled and not self.m_defibrillator.m_enabled then
        -- Throttle energy regen once every 100ms
        if time_global() - self.m_energy_last_regen > self.m_energy_regen_rate then
            self.m_energy = clamp(self.m_energy + 1, 0, 100)
            self.m_energy_last_regen = time_global()
        end
    end

    -- Energy low voice
    if self.m_energy <= self.m_energy_low_threshold and not self.m_energy_low_voiced and not self.m_malfunctor.m_enabled then
        self.m_sounds.energy_low_voice:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d)
        self.m_energy_low_voiced = true
    end
    if (self.m_malfunctor.m_enabled or self.m_energy > self.m_energy_low_threshold) and self.m_energy_low_voiced then
        self.m_sounds.energy_low_voice:stop()
        self.m_energy_low_voiced = false
    end

    -- Energy very low
    if self.m_energy <= self.m_energy_very_low_threshold and not self.m_energy_very_low_voiced and not self.m_malfunctor.m_enabled then
        self.m_sounds.energy_very_low:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d + sound_object.looped)
        self.m_energy_very_low_voiced = true
    end
    if (self.m_malfunctor.m_enabled or self.m_energy > self.m_energy_very_low_threshold) and self.m_energy_very_low_voiced then
        self.m_sounds.energy_very_low:stop()
        self.m_energy_very_low_voiced = false
    end

    -- Energy off
    if self.m_energy <= self.m_energy_off_threshold and not self.m_energy_off_voiced then
        self.m_sounds.energy_off:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d)
        self.m_energy_off_voiced = true
    end
    if self.m_energy > self.m_energy_off_threshold and self.m_energy_off_voiced then
        self.m_sounds.energy_off:stop()
        self.m_energy_off_voiced = false
    end

    -- Energy on
    if self.m_energy > self.m_energy_on_threshold and not self.m_energy_on_voiced then
        self.m_sounds.energy_on:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d)
        self.m_energy_on_voiced = true
    end
    if self.m_energy <= self.m_energy_on_threshold and self.m_energy_on_voiced then
        self.m_sounds.energy_on:stop()
        self.m_energy_on_voiced = false
    end
end
