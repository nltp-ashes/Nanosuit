---                                                                                                                  ---
---    Script used to handle the core logic of the Nanosuit addon.                                                   ---
---                                                                                                                  ---
---    get_instance() runs on hot paths, the NPC visibility hook among them, so it reads the core from a module      ---
---    variable instead of looking up the worn outfit. The binder sets it once the core is loaded, and clears it     ---
---    before destroying the core.                                                                                   ---
---                                                                                                                  ---
---    The default mode is applied last in core:__init : a mode and the boosters it applies may reach any            ---
---    subsystem of the core from apply().                                                                           ---
---                                                                                                                  ---
---==================================================================================================================---

-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- Imports
armor_modes_enum                       = nanosuit_utils.armor_modes_enum

-- Constants
VERSION                                = "0.15.0"

-- Globals
instance                               = nil

-- ---------------------------------------------------------------------------------------------------------------------
-- General functions
-- ---------------------------------------------------------------------------------------------------------------------

function on_game_load()
    nanosuit_utils.print_i("Nanosuit version %s", VERSION)
end

function get_instance()
    return instance
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Core class
-- ---------------------------------------------------------------------------------------------------------------------

class "core"

function core:__init()
    -- Armor modes
    self.m_modes = {
        [armor_modes_enum.armor] = nanosuit_mode_armor[armor_modes_enum.armor](self, armor_modes_enum.armor),
        [armor_modes_enum.power] = nanosuit_mode_power[armor_modes_enum.power](self, armor_modes_enum.power),
        [armor_modes_enum.speed] = nanosuit_mode_speed[armor_modes_enum.speed](self, armor_modes_enum.speed),
        [armor_modes_enum.cloak] = nanosuit_mode_cloak[armor_modes_enum.cloak](self, armor_modes_enum.cloak)
    }

    -- Shaders
    self.m_glow = nanosuit_shader_glow.glow(self)
    self.m_cloak = nanosuit_shader_cloak.cloak(self)

    -- Default mode initialization
    self.m_default_mode = armor_modes_enum.armor
    self.m_current_mode = self.m_modes[self.m_default_mode]

    -- UIs
    self.m_hud = nanosuit_ui_hud.ui_hud(self)

    -- Energy
    self.m_energy = nanosuit_energy.energy(self)
    self.m_energy_cues = nanosuit_energy_cues.energy_cues(self)

    -- Others
    self.m_vaporizer = nanosuit_vaporizer.vaporizer(self)
    self.m_malfunctor = nanosuit_malfunctor.malfunctor(self)
    self.m_defibrillator = nanosuit_defibrillator.defibrillator(self)
    self.m_nightvision = nanosuit_nightvision.nightvision(self)
    self.m_binoculars = nanosuit_binoculars.binoculars(self)
    self.m_interference = nanosuit_interference.interference(self)
    self.m_psy_voices = nanosuit_psy_voices.psy_voices(self)

    -- Register callbacks
    RegisterScriptCallback("on_option_change", self)

    -- Default mode application
    self.m_current_mode:apply(false, true)
end

function core:__finalize()
    nanosuit_utils.print_i("Core garbage collected")
end

function core:destroy()
    self.m_current_mode:remove(true)

    for _, mode in pairs(self.m_modes) do
        mode:destroy()
    end

    UnregisterScriptCallback("on_option_change", self)

    self.m_hud:destroy()
    self.m_energy:destroy()
    self.m_energy_cues:destroy()
    self.m_vaporizer:destroy()
    self.m_malfunctor:destroy()
    self.m_defibrillator:destroy()
    self.m_nightvision:destroy()
    self.m_binoculars:destroy()
    self.m_interference:destroy()
    self.m_psy_voices:destroy()
    self.m_glow:destroy()
    self.m_cloak:destroy()
end

function core:save()
    local storage = {}
    storage.energy = self.m_energy.m_level
    storage.energy_low_voiced = self.m_energy_cues.m_low_voiced
    storage.energy_very_low_voiced = self.m_energy_cues.m_very_low_voiced
    storage.energy_off_voiced = self.m_energy_cues.m_off_voiced
    storage.energy_on_voiced = self.m_energy_cues.m_on_voiced

    storage.current_mode = self.m_current_mode.m_name
    storage.modes = {}
    for name, mode in pairs(self.m_modes) do
        storage.modes[name] = mode.save and mode:save() or {}
    end

    storage.vaporizer = self.m_vaporizer.save and self.m_vaporizer:save() or {}
    storage.malfunctor = self.m_malfunctor.save and self.m_malfunctor:save() or {}
    storage.defibrillator = self.m_defibrillator.save and self.m_defibrillator:save() or {}
    storage.nightvision = self.m_nightvision.save and self.m_nightvision:save() or {}
    storage.binoculars = self.m_binoculars.save and self.m_binoculars:save() or {}
    storage.interference = self.m_interference.save and self.m_interference:save() or {}

    return storage
end

function core:load(storage)
    self.m_energy.m_level = storage.energy or self.m_energy.m_level

    if storage.energy_low_voiced ~= nil then
        self.m_energy_cues.m_low_voiced = storage.energy_low_voiced
    end

    if storage.energy_very_low_voiced ~= nil then
        self.m_energy_cues.m_very_low_voiced = storage.energy_very_low_voiced
    end

    if storage.energy_off_voiced ~= nil then
        self.m_energy_cues.m_off_voiced = storage.energy_off_voiced
    end

    if storage.energy_on_voiced ~= nil then
        self.m_energy_cues.m_on_voiced = storage.energy_on_voiced
    end

    for name, mode in pairs(self.m_modes) do
        if storage.modes and storage.modes[name] and mode.load then
            mode:load(storage.modes[name])
        end
    end

    if storage.vaporizer and self.m_vaporizer.load then
        self.m_vaporizer:load(storage.vaporizer)
    end

    if storage.malfunctor and self.m_malfunctor.load then
        self.m_malfunctor:load(storage.malfunctor)
    end

    if storage.defibrillator and self.m_defibrillator.load then
        self.m_defibrillator:load(storage.defibrillator)
    end

    if storage.nightvision and self.m_nightvision.load then
        self.m_nightvision:load(storage.nightvision)
    end

    if storage.binoculars and self.m_binoculars.load then
        self.m_binoculars:load(storage.binoculars)
    end

    if storage.interference and self.m_interference.load then
        self.m_interference:load(storage.interference)
    end

    if storage.current_mode then
        self:change_mode(storage.current_mode, false)
    end
end

function core:change_mode(mode, play_voice)
    if self.m_current_mode ~= self.m_modes[mode] then
        local current_mode_name = self.m_current_mode.m_name
        self.m_current_mode:remove(false)
        self.m_current_mode = self.m_modes[mode]
        self.m_current_mode:apply(play_voice, current_mode_name ~= armor_modes_enum.cloak)
    end
end

function core:on_option_change()
    -- Restart UI
    self.m_hud:destroy()
    self.m_hud = nanosuit_ui_hud.ui_hud(self)
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Callbacks registration
-- ---------------------------------------------------------------------------------------------------------------------

function on_game_start()
    RegisterScriptCallback("on_game_load", on_game_load)
end
