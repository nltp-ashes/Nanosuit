-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- Imports
localized_sound_object  = nanosuit_utils.localized_sound_object
actor_slots_enum        = nanosuit_utils.actor_slots_enum
armor_modes_enum        = nanosuit_utils.armor_modes_enum

-- Singleton
instance                = nil

-- Variables
loaded_m_data           = {}

-- ---------------------------------------------------------------------------------------------------------------------
-- General functions
-- ---------------------------------------------------------------------------------------------------------------------

function actor_item_to_slot(_)
    nextTick(function()
        local outfit = db.actor:item_in_slot(actor_slots_enum.outfit)
        if outfit ~= nil and outfit:section() == "outfit_nanosuit" then
            create_instance_if_not_exists()
        end
        return true
    end)
end

function actor_item_to_ruck(_)
    nextTick(function()
        local outfit = db.actor:item_in_slot(actor_slots_enum.outfit)
        if outfit == nil or outfit:section() ~= "outfit_nanosuit" then
            destroy_instance_if_exists()
        end
        return true
    end)
end

function actor_on_item_drop(_)
    nextTick(function()
        local outfit = db.actor:item_in_slot(actor_slots_enum.outfit)
        if outfit == nil or outfit:section() ~= "outfit_nanosuit" then
            destroy_instance_if_exists()
        end
        return true
    end)
end

function actor_on_net_destroy()
    destroy_instance_if_exists()
end

function save_state(m_data)
    if instance ~= nil then
        m_data.nanosuit = {}
        instance:save(m_data.nanosuit)
    end
end

function load_state(m_data)
    loaded_m_data = m_data.nanosuit or loaded_m_data
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Instance management functions
-- ---------------------------------------------------------------------------------------------------------------------

function create_instance_if_not_exists()
    if instance == nil then
        printf("[NS] Nanosuit core initializing")
        instance = core()
        printf("[NS] Nanosuit core initialized")
    end
end

function destroy_instance_if_exists()
    if instance ~= nil then
        printf("[NS] Nanosuit core destroying")
        instance:destroy()
        instance = nil
        printf("[NS] Nanosuit core destroyed")
    end
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Callbacks registration
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to register callbacks.
--- @return nil
function on_game_start()
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
    RegisterScriptCallback("actor_item_to_slot", actor_item_to_slot)
    RegisterScriptCallback("actor_item_to_ruck", actor_item_to_ruck)
    RegisterScriptCallback("actor_on_item_drop", actor_on_item_drop)
    RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Core class
-- ---------------------------------------------------------------------------------------------------------------------

class "core"

function core:__init()
    -- Constants
    self.m_energy_regen_rate = 100
    self.m_energy_regen_delay = 5000
    self.m_energy_low_threshold = 20
    self.m_energy_very_low_threshold = 10
    self.m_energy_off_threshold = 0
    self.m_energy_on_threshold = 0

    -- Variables
    self.m_energy = 100
    self.m_energy_last_use = 0
    self.m_energy_last_regen = 0
    self.m_energy_low_voiced = true
    self.m_energy_very_low_voiced = true
    self.m_energy_off_voiced = true
    self.m_energy_on_voiced = true

    -- Sound effects
    self.m_sounds = {
        energy_low_voice = localized_sound_object([[nanosuit\voice\energy_low_voice]]),
        energy_very_low = sound_object([[nanosuit\energy\energy_very_low]]),
        energy_on = sound_object([[nanosuit\energy\energy_on]]),
        energy_off = sound_object([[nanosuit\energy\energy_off]])
    }

    -- Armor modes
    self.m_modes = {
        [armor_modes_enum.armor] = nanosuit_mode_armor[armor_modes_enum.armor](armor_modes_enum.armor),
        [armor_modes_enum.power] = nanosuit_mode_power[armor_modes_enum.power](armor_modes_enum.power),
        [armor_modes_enum.speed] = nanosuit_mode_speed[armor_modes_enum.speed](armor_modes_enum.speed),
        [armor_modes_enum.cloak] = nanosuit_mode_cloak[armor_modes_enum.cloak](armor_modes_enum.cloak)
    }

    -- Default mode initialization
    self.m_default_mode = armor_modes_enum.armor
    self.m_current_mode = self.m_modes[self.m_default_mode]
    self.m_current_mode:apply(false)

    -- UIs
    self.m_hud = nanosuit_ui_hud.ui_hud()

    -- Others
    self.m_vaporizer = nanosuit_vaporizer.vaporizer()
    self.m_malfunctor = nanosuit_malfunctor.malfunctor()
    self.m_defibrillator = nanosuit_defibrillator.defibrillator()

    -- Register callbacks
    RegisterScriptCallback("actor_on_death", self)
    RegisterScriptCallback("actor_on_update", self)
    RegisterScriptCallback("on_option_change", self)
end

function core:__finalize()
    printf("[NS] Nanosuit core garbage collected")
end

function core:destroy()
    self.m_current_mode:remove()

    UnregisterScriptCallback("actor_on_death", self)
    UnregisterScriptCallback("actor_on_update", self)
    UnregisterScriptCallback("on_option_change", self)

    for _, sfx in pairs(self.m_sounds) do
        if sfx:playing() then
            sfx:stop()
        end
    end

    self.m_hud:destroy()
    self.m_vaporizer:destroy()
    self.m_malfunctor:destroy()
    self.m_defibrillator:destroy()
end

function core:save(m_data)
    m_data.energy = self.m_energy
    --m_data.energy_last_use = time_global() - self.m_energy_last_use
    --m_data.energy_last_regen = time_global() - self.m_energy_last_regen
    m_data.energy_low_voiced = self.m_energy_low_voiced
    m_data.energy_very_low_voiced = self.m_energy_very_low_voiced
    m_data.energy_off_voiced = self.m_energy_off_voiced
    m_data.energy_on_voiced = self.m_energy_on_voiced

    m_data.modes = {}
    for name, mode in pairs(self.m_modes) do
        m_data.modes[name] = mode.save and mode:save() or {}
    end

    m_data.vaporizer = self.m_vaporizer.save and self.m_vaporizer:save() or {}
    m_data.malfunctor = self.m_malfunctor.save and self.m_malfunctor:save() or {}
    m_data.defibrillator = self.m_defibrillator.save and self.m_defibrillator:save() or {}
end

function core:load(m_data)
    self.m_energy = m_data.energy or self.m_energy
    --self.m_energy_last_use = (m_data.energy_last_use and time_global() + m_data.energy_last_use) or self.m_energy_last_use
    --self.m_energy_last_regen = (m_data.energy_last_regen and time_global() + m_data.energy_last_regen) or self.m_energy_last_regen
    self.m_energy_low_voiced = m_data.energy_low_voiced or self.m_energy_low_voiced
    self.m_energy_very_low_voiced = m_data.energy_very_low_voiced or self.m_energy_very_low_voiced
    self.m_energy_off_voiced = m_data.energy_off_voiced or self.m_energy_off_voiced
    self.m_energy_on_voiced = m_data.energy_on_voiced or self.m_energy_on_voiced

    for name, mode in pairs(self.m_modes) do
        if m_data.modes and m_data.modes[name] and mode.load then
            mode:load(m_data.modes[name])
        end
    end

    if m_data.vaporizer and self.m_vaporizer.load then
        self.m_vaporizer:load(m_data.vaporizer)
    end

    if m_data.malfunctor and self.m_malfunctor.load then
        self.m_malfunctor:load(m_data.malfunctor)
    end

    if m_data.defibrillator and self.m_defibrillator.load then
        self.m_defibrillator:load(m_data.defibrillator)
    end
end

function core:use_energy(amount)
    self.m_energy = clamp(self.m_energy - amount, 0, 100)
    self.m_energy_last_use = time_global()
end

function core:change_mode(mode, play_voice)
    if self.m_current_mode ~= self.m_modes[mode] then
        self.m_current_mode:remove()
        self.m_current_mode = self.m_modes[mode]
        self.m_current_mode:apply(play_voice)
    end
end

function core:on_option_change()
    self.m_hud:destroy()
    self.m_hud = nanosuit_ui_hud.ui_hud(self)
end

function core:actor_on_death()
    for _, sfx in pairs(self.m_sounds) do
        if sfx:playing() then
            sfx:stop()
        end
    end
end

function core:actor_on_update()
    -- Load
    if loaded_m_data then
        self:load(loaded_m_data)
        loaded_m_data = nil
    end

    -- Delay energy regen 5s after last energy use
    if time_global() - self.m_energy_last_use > self.m_energy_regen_delay and not self.m_malfunctor.m_enabled and not self.m_defibrillator.m_enabled then
        -- Throttle energy regen once every 100ms
        if time_global() - self.m_energy_last_regen > self.m_energy_regen_rate then
            self.m_energy = clamp(self.m_energy + 1, 0, 100)
            self.m_energy_last_regen = time_global()
        end
    end

    -- Energy low voice
    if self.m_energy <= self.m_energy_low_threshold and not self.m_energy_low_voiced and not self.m_malfunctor.m_enabled then
        self.m_sounds.energy_low_voice:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d)
        self.m_energy_low_voiced = true
    end
    if (self.m_malfunctor.m_enabled or self.m_energy > self.m_energy_low_threshold) and self.m_energy_low_voiced then
        self.m_sounds.energy_low_voice:stop()
        self.m_energy_low_voiced = false
    end

    -- Energy very low
    if self.m_energy <= self.m_energy_very_low_threshold and not self.m_energy_very_low_voiced and not self.m_malfunctor.m_enabled then
        self.m_sounds.energy_very_low:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d + sound_object.looped)
        self.m_energy_very_low_voiced = true
    end
    if (self.m_malfunctor.m_enabled or self.m_energy > self.m_energy_very_low_threshold) and self.m_energy_very_low_voiced then
        self.m_sounds.energy_very_low:stop()
        self.m_energy_very_low_voiced = false
    end

    -- Energy off
    if self.m_energy <= self.m_energy_off_threshold and not self.m_energy_off_voiced then
        self.m_sounds.energy_off:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d)
        self.m_energy_off_voiced = true
    end
    if self.m_energy > self.m_energy_off_threshold and self.m_energy_off_voiced then
        self.m_sounds.energy_off:stop()
        self.m_energy_off_voiced = false
    end

    -- Energy on
    if self.m_energy > self.m_energy_on_threshold and not self.m_energy_on_voiced then
        self.m_sounds.energy_on:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d)
        self.m_energy_on_voiced = true
    end
    if self.m_energy <= self.m_energy_on_threshold and self.m_energy_on_voiced then
        self.m_sounds.energy_on:stop()
        self.m_energy_on_voiced = false
    end
end
