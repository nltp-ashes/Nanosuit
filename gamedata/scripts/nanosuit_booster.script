---                                                                                                                  ---
---    Script used to handle the logic of an abstract booster usable by a Nanosuit mode.                             ---
---                                                                                                                  ---
---    A booster is an effect a mode turns on when it is applied and off when it is removed. This class only         ---
---    carries that lifecycle.                                                                                       ---
---                                                                                                                  ---
---==================================================================================================================---

-- ---------------------------------------------------------------------------------------------------------------------
-- Booster class
-- ---------------------------------------------------------------------------------------------------------------------

class "abstract_booster"

function abstract_booster:__init(core)
    self.m_core = core
end

function abstract_booster:destroy()
    self.m_core = nil
end

function abstract_booster:apply()
    nanosuit_utils.print_dbg("Applying booster")
end

function abstract_booster:remove()
    nanosuit_utils.print_dbg("Removing booster")
end
