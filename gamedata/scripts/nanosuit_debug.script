-- ---------------------------------------------------------------------------------------------------------------------
-- Dummy anim seq
-- ---------------------------------------------------------------------------------------------------------------------

class "dummy_sequence" (nanosuit_sequence.scripted_sequence)

function dummy_sequence:__init() super()
end

function dummy_sequence:destroy()
    nanosuit_sequence.scripted_sequence.destroy(self)
end

function dummy_sequence:action_1()
    printf("[NS] Dummy anim seq action 1 called")
    return true
end

function dummy_sequence:action_2()
    printf("[NS] Dummy anim seq action 2 called")
    return true
end

function dummy_sequence:action_3()
    printf("[NS] Dummy anim seq action 3 called")
    return true
end

function dummy_sequence:action_4()
    printf("[NS] Dummy anim seq action 4 called")
    return true
end