---                                                                                                                  ---
---    Script used to handle the logic of cloak mode of the Nanosuit addon.                                          ---
---                                                                                                                  ---
---    The look belongs to the core's m_cloak, engaged before the cloak boosters are applied and disengaged after    ---
---    they are removed, so the surfaces they hand over fade out with the suit after the mode is gone. The NPC       ---
---    vision, the drain and the sounds stop with the mode.                                                          ---
---                                                                                                                  ---
---==================================================================================================================---

-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- Imports
energy_drain_enum       = nanosuit_utils.energy_drain_enum

-- ---------------------------------------------------------------------------------------------------------------------
-- Cloak mode class
-- ---------------------------------------------------------------------------------------------------------------------

class "cloak" (nanosuit_mode.abstract_mode)

function cloak:__init(core, name) super(core, name)
    -- Energy variables
    self.m_energy_drain_min = 0.1
    self.m_energy_drain_max = 1
    self.m_energy_drain_rate = 100

    -- Sound effects
    self.m_sounds.loop = sound_object([[nanosuit\modes\cloak\mode_cloak_loop]])
    self.m_sounds.shoot = sound_object([[nanosuit\modes\cloak\mode_cloak_shoot]])
    self.m_sounds.on = sound_object([[nanosuit\modes\cloak\mode_cloak_on]])
    self.m_sounds.off = sound_object([[nanosuit\modes\cloak\mode_cloak_off]])
end

function cloak:apply(play_voice, play_on)
    nanosuit_mode.abstract_mode.apply(self, play_voice, play_on, nil)

    self.m_core.m_energy:add_drain(energy_drain_enum.cloak, self.m_energy_drain_rate, function()
        local movement = db.actor:get_movement_speed()
        local speed_mps = nanosuit_utils.vec_magnitude_xz(movement)
        return self.m_energy_drain_min + normalize(speed_mps, 0, 6) * self.m_energy_drain_max
    end)
    
    -- Play sounds
    self.m_sounds.loop:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d + sound_object.looped)

    -- Register callbacks
    RegisterScriptCallback("actor_on_update", self)
    RegisterScriptCallback("actor_on_weapon_fired", self)

    -- Set player invisible
    self.m_core.m_cloak:engage()

    -- Boosters
    self:apply_booster(nanosuit_booster_cloak_actor.cloak_actor)
    self:apply_booster(nanosuit_booster_cloak_hud.cloak_hud)
    self:apply_booster(nanosuit_booster_cloak_legs.cloak_legs)
    self:apply_booster(nanosuit_booster_item_cloak.cloak)
    self:apply_booster(nanosuit_booster_stealth.stealth)
end

function cloak:remove(is_destroying)
    nanosuit_mode.abstract_mode.remove(self, is_destroying)

    self.m_core.m_energy:remove_drain(energy_drain_enum.cloak)

    -- Play sounds
    self.m_sounds.off:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d)
    self.m_sounds.loop:stop()

    -- Unregister callbacks
    UnregisterScriptCallback("actor_on_update", self)
    UnregisterScriptCallback("actor_on_weapon_fired", self)

    -- Boosters
    self:remove_booster(nanosuit_booster_cloak_actor.cloak_actor)
    self:remove_booster(nanosuit_booster_cloak_hud.cloak_hud)
    self:remove_booster(nanosuit_booster_cloak_legs.cloak_legs)
    self:remove_booster(nanosuit_booster_item_cloak.cloak)
    self:remove_booster(nanosuit_booster_stealth.stealth)

    -- Reset player visibility
    if not is_destroying then
        self.m_core.m_cloak:disengage()
    end
end

function cloak:actor_on_update()
    -- Switch to armor mode when out of energy
    if self.m_core.m_energy.m_level <= 0 then
        self.m_core:change_mode(self.m_core.m_default_mode, true)
    end
end

function cloak:actor_on_weapon_fired()
    self.m_sounds.shoot:play_at_pos(db.actor, VEC_ZERO, 0, sound_object.s2d)
    self.m_core.m_energy:use_energy(100)
    self.m_core:change_mode(self.m_core.m_default_mode, true)
end
