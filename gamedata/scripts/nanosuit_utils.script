-- ---------------------------------------------------------------------------------------------------------------------
-- Debug functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to print information into the console/log file only when Nanosuit' debug mode is enabled.
--- @return nil
function dbg_printf(...)
    if nanosuit_mcm.get_config("technical", "debug_mode") then
        printf(...)
    end
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Vector functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to get the magnitude of a vector on the XZ plane.
--- @param vec vector
--- @return number
function vec_magnitude_xz(vec)
    local vec_xz = vector():set(vec.x, 0, vec.z)
    return vec_xz:magnitude()
end

--- Function used to calculate the distance between two 2D vectors.
--- @param lhs vector
--- @param rhs vector
--- @return number
function vec2_distance_to(lhs, rhs)
    return math.sqrt((rhs.x - lhs.x) ^ 2 + (rhs.y - lhs.y) ^ 2)
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Color functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to get a CSV string of ARGB components into a float representation.
--- @param str string
--- @return number
function string_to_float(str)
    local comp = str_explode(str, ",")
    return GetARGB(tonumber(comp[1]), tonumber(comp[2]), tonumber(comp[3]), tonumber(comp[4]))
end

--- Function used to convert a float color value to a ARGB table.
--- @param clr number
--- @return table
function float_to_argb(clr)
    return {
        a = bit.band(bit.rshift(clr, 24), 255),
        r = bit.band(bit.rshift(clr, 16), 255),
        g = bit.band(bit.rshift(clr, 8), 255),
        b = bit.band(clr, 255)
    }
end

--- Function used to convert a ARGB table to a string representation used for UIs.
--- @param clr table
--- @return string
function argb_to_ui(clr)
    return strformat("%c[%s,%s,%s,%s]", clr.a, clr.r, clr.g, clr.b)
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Sound functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to get a sound object localized to the game's language (if available) and in the correct gender.
--- The gender is decided by the parent directory, the language is decided by a suffix.
--- For example:
--- - path\to\male\my_sound | path\to\female\my_sound
--- - path\to\male\my_sound_rus | path\to\female\my_sound_rus
--- - path\to\male\my_sound_fra | path\to\female\my_sound_fra
--- Then call the function localized_and_genderized_sound_object([[path\to]], "my_sound").
--- The sound file without suffix should be the english (or default) version.
--- @param path string
--- @param filename string
--- @return sound_object
function localized_and_genderized_sound_object(path, filename)
    local gender = nanosuit_mcm.get_config("general", "suit_gender")
    local locale = ini_sys:r_string_ex("string_table", "language")
    return sound_object(path .. [[\]] .. gender .. [[\]] .. filename .. "_" .. locale)
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Translation functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to know if there exists a translation for a given game string.
--- @param str string
--- @return boolean
function has_translation(str)
    return game.translate_string(str) ~= str
end

--- Function used to get the translation of a given string by its ID.
--- The function can interpolate %s in the string with the given arguments.
--- @param str string
--- @param ... any
--- @return string
function get_translation(str, ...)
    if not has_translation(str) then
        return str .. "[Missing translation]"
    end

    local string = game.translate_string(str)

    if (select('#', ...) >= 1) then
        local i = 0
        local p = { ... }
        local function sr()
            i = i + 1
            if (type(p[i]) == "userdata") then
                return "userdata"
            end
            return tostring(p[i])
        end
        string = string.gsub(string, "%%s", sr)
    end

    return string
end

--- Function used to print the a textual version of a DIK key.
--- @param dik DIK_keys
--- @return string
function get_key_translation(dik)
    return dik_to_keyname(dik, true)
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Data functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to pad a string with 0s.
--- The function will add 0s before the number to match the desired length.
--- @param var any
--- @param length number
--- @return string
function string_pad_l(var, char, length)
    local ret = var
    if length then
        while #ret < length do
            ret = char .. ret
        end
    end
    return ret
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Post-process effectors functions
-- ---------------------------------------------------------------------------------------------------------------------

local active_pp_effectors = {}

function add_pp_effector(name, id, looped)
    if has_pp_effector(id) then
        remove_pp_effector(id)
    end
    level.add_pp_effector(name, id, looped)
    if looped then
        active_pp_effectors[id] = { name = name, factor = 1 }
    end
end

function remove_pp_effector(id)
    if has_pp_effector(id) then
        level.remove_pp_effector(id)
        active_pp_effectors[id] = nil
    end
end

function has_pp_effector(id)
    return active_pp_effectors[id] ~= nil
end

function set_pp_effector_factor(id, factor)
    if has_pp_effector(id) then
        level.set_pp_effector_factor(id, factor)
        active_pp_effectors[id].factor = factor
    end
end

function get_pp_effector_factor(id)
    if has_pp_effector(id) then
        return active_pp_effectors[id].factor
    end
    return 0
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Renderer functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to get the current renderer used by the game.
--- @return renderers_enum
function get_renderer()
    local renderers = {
        ["renderer_r4"] = renderers_enum.dx11,
        ["renderer_r3"] = renderers_enum.dx10,
        ["renderer_r2a"] = renderers_enum.dx9,
        ["renderer_r2.5"] = renderers_enum.dx9,
        ["renderer_r1"] = renderers_enum.dx8,
    }

    return renderers[get_console_cmd(0, "renderer")]
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Task functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to get all the current targets of active tasks.
--- The function returns for each target ID, the task ID, the target object, and the task type.
--- @return table
function get_all_task_targets()
    local targets = {}

    -- Go through real game tasks
    local tm = task_manager.get_task_manager()
    for tsk_id, tsk in pairs(tm.task_info) do
        local obj = this.get_true_task_target(tsk_id)
        if obj then
            targets[obj:id()] = { tsk_id = tsk_id, obj = obj, primary = tsk.storyline, secondary = not tsk.storyline }
        end
    end

    -- Specific case for guide task
    if tasks_guide.curr_guid and tasks_guide.curr_guid.id_smart then
        local obj = level.object_by_id(tasks_guide.curr_guid.id_smart)
        if obj then
            targets[obj:id()] = { tsk_id = nil, obj = obj, primary = false, secondary = true }
        end
    end

    return targets
end

--- Function used to get the current target of a task by its ID.
--- The function returns a game object or nil if there is no target.
--- @param tsk_id number
--- @return game_object
function get_true_task_target(tsk_id)
    -- Check if task is still active (tasks in task_manager.task_info can be completed but not yet removed)
    if db.actor:get_task(tsk_id, true) == nil then
        return nil
    end

    -- Get task
    local tm = task_manager.get_task_manager()
    local tsk = tm.task_info[tsk_id]

    -- Start with target pointed by task
    local target_id = tsk.current_target
    if not target_id then
        return nil
    end

    -- Special case for squads : they don't have game objects, so we target a member instead
    local se_obj = alife_object(target_id)
    if nanosuit_utils.is_squad(se_obj) then
        for member in se_obj:squad_members() do
            target_id = member.id
        end
    end

    -- Always return the top most item in the inventory owner chain
    local obj = level.object_by_id(target_id)
    while obj and obj:parent() ~= nil do
        obj = obj:parent()
    end

    -- Refresh server object if needed
    if obj and se_obj.id ~= obj:id() then
        se_obj = alife_object(obj:id())
    end

    -- If target is on another level, point to the optimal level changer towards the target
    if not simulation_objects.is_on_the_same_level(alife():actor(), se_obj) then
        -- Source level (player location)
        local src_level = level.name()

        -- Target level (object location)
        local obj_lid = game_graph():vertex(se_obj.m_game_vertex_id):level_id()
        local tgt_level = obj_lid and obj_lid < 50 and alife():level_name(obj_lid)

        -- Calculate travel plan
        local plan = this.get_route_plan_to_target(txr_routes.sec_to_map[src_level], txr_routes.sec_to_map[tgt_level], {})

        -- Get level changers between source level and next level in plan
        local lcs = plan and txr_routes.get_route(plan[1], plan[2])

        -- Fetch game object of level changer
        local lc_se = lcs and get_story_se_object(lcs[1])
        return lc_se and level.object_by_id(lc_se.id)
    end

    return obj
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Unique calls functions
-- ---------------------------------------------------------------------------------------------------------------------

--- Function used to add a unique call (function called every frame) to the level.
--- @param callback function
--- @return function
function add_unique_call(callback, ...)
    local args = { ... }
    local wrapper = function()
        if callback(unpack(args)) then
            return true
        end
        return false
    end
    AddUniqueCall(wrapper)
    return wrapper
end

--- Function used to remove a unique call (function called every frame) from the level.
--- @param callback function
--- @return nil
function remove_unique_call(callback)
    RemoveUniqueCall(callback)
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Route functions
-- ---------------------------------------------------------------------------------------------------------------------

-- Helper: build banned lookup table from list
function build_banned_table(banned_levels)
    local banned = {}
    if banned_levels then
        for _, lvl in ipairs(banned_levels) do
            banned[lvl] = true
        end
    end
    return banned
end

-- Helper: get neighbors for a level, excluding banned
function get_neighbors(level, banned)
    local neighbors = {}
    local transitions = txr_routes.routes[level]
    if transitions then
        for neighbor, story_ids in pairs(transitions) do
            if not banned[neighbor] then
                local story_id = story_ids[1]
                table.insert(neighbors, { level = neighbor, story_id = story_id })
            end
        end
    end
    return neighbors
end

-- Helper: get position of transition object for a given story id
function get_transition_pos(story_id)
    local obj = get_story_se_object(story_id)
    if obj and obj.position then
        return obj.position
    end
    return nil
end

-- Helper: collect all unique levels (sources and destinations), excluding banned
function collect_all_levels(banned)
    local all_levels = {}
    for src, transitions in pairs(txr_routes.routes) do
        if not banned[src] then
            all_levels[src] = true
        end
        for dst in pairs(transitions) do
            if not banned[dst] then
                all_levels[dst] = true
            end
        end
    end
    return all_levels
end

function get_route_plan_to_target(start, target, banned_levels)
    local banned = build_banned_table(banned_levels)
    if banned[start] or banned[target] then
        return nil
    end
    if start == target then
        return { start }
    end

    local visited = {}
    local dist = {}
    local prev = {}
    local queue = {}

    local all_levels = collect_all_levels(banned)
    for k in pairs(all_levels) do
        dist[k] = math.huge
        prev[k] = nil
    end
    dist[start] = 0
    table.insert(queue, { level = start, cost = 0 })

    while #queue > 0 do
        table.sort(queue, function(a, b)
            return a.cost < b.cost
        end)
        local current = table.remove(queue, 1)
        local curr_level = current.level
        if not visited[curr_level] then
            visited[curr_level] = true
            if curr_level == target then
                break
            end

            local curr_neighbors = get_neighbors(curr_level, banned)
            local curr_pos = nil
            if curr_level ~= start then
                local incoming = txr_routes.routes[prev[curr_level]] and txr_routes.routes[prev[curr_level]][curr_level]
                if incoming then
                    curr_pos = get_transition_pos(incoming[1])
                end
            end

            for _, neighbor in ipairs(curr_neighbors) do
                local n_level = neighbor.level
                if not visited[n_level] and not banned[n_level] then
                    local n_pos = get_transition_pos(neighbor.story_id)
                    local step_dist = 1
                    if curr_pos and n_pos then
                        step_dist = curr_pos:distance_to(n_pos)
                    end
                    local alt = dist[curr_level] + step_dist
                    if alt < dist[n_level] then
                        dist[n_level] = alt
                        prev[n_level] = curr_level
                        table.insert(queue, { level = n_level, cost = alt })
                    end
                end
            end
        end
    end

    local path = {}
    local u = target
    if not prev[u] and start ~= target then
        return nil
    end
    while u do
        table.insert(path, 1, u)
        u = prev[u]
    end
    return path
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Aspect correction functions
-- ---------------------------------------------------------------------------------------------------------------------

function scale_ui_element(ele, adjust_x, anchor, anchor_point, parent_width)
    return arm.scale_ui(ele, adjust_x, anchor, anchor_point, parent_width)
end

function scale_ui_position(pos)
    local aspect_ratio = screen_scale.y / screen_scale.x
    local pos_x = pos.x * aspect_ratio
    return vector2():set(pos_x, pos.y)
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Testing functions
-- ---------------------------------------------------------------------------------------------------------------------

function is_nanosuit(obj)
    if not obj then
        return false
    end
    local sec = obj:section()
    local script_binding = ini_sys:r_string_ex(sec, "script_binding")
    return script_binding == "nanosuit_core.bind"
end

function is_quest_item(obj)
    if not obj then
        return false
    end
    local sec = obj:section()
    return IsItem("quest", sec)
end

function is_smart_terrain(obj)
    if not obj then
        return false
    end
    local c = obj:clsid()
    return c == clsid.smart_terrain
end

function is_space_restrictor(obj)
    if not obj then
        return false
    end
    local c = obj:clsid()
    return c == clsid.space_restrictor or c == clsid.script_restr
end

function is_squad(obj)
    if not obj then
        return false
    end
    local c = obj:clsid()
    return c == clsid.online_offline_group or c == clsid.online_offline_group_s
end

function is_electro_anomaly(obj)
    if not obj then
        return false
    end
    local c = obj:clsid()
    if c ~= clsid.zone_mosquito_bald and c ~= clsid.zone_mbald_s then
        return false
    end
    local sec = obj:section()
    local hit_type = ini_sys:r_string_ex(sec, "hit_type")
    return hit_type == hit_types_names_enum[hit_types_enum.shock]
end

function is_machine_gun(obj)
    if not obj then
        return false
    end
    local name = obj:name()
    return machine_guns_whitelist[name] or false
end

function is_true_car(obj)
    if not obj then
        return false
    end
    return IsCar(obj) and not is_machine_gun(obj)
end