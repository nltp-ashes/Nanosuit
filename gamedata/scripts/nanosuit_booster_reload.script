---                                                                                                                  ---
---    Script used to handle the logic of a reload speed booster usable by a Nanosuit mode.                          ---
---                                                                                                                  ---
---    Beware that the engine only falls back on the animation speed written in the configs when the callbacks       ---
---    leave anm_speed at 1 (see attachable_hud_item::anim_play), so writing the boosted speed straight into         ---
---    anm_speed would quietly discard the speed of every weapon that declares one. That speed is resolved by        ---
---    hand before being scaled.                                                                                     ---
---                                                                                                                  ---
---==================================================================================================================---

-- ---------------------------------------------------------------------------------------------------------------------
-- Reload booster class
-- ---------------------------------------------------------------------------------------------------------------------

class "reload" (nanosuit_booster.abstract_booster)

function reload:__init(core, name) super(core, name)
    self.m_reload_speed_coef = 1.25
    self.m_anim_prefixes = {
        "anm_reload",
        "anm_add_cartridge",
        "anm_open",
        "anm_close"
    }
    self.m_sound_aliases = {
        sndReload             = true,
        sndReload1            = true,
        sndReloadActor        = true,
        sndReloadEmpty        = true,
        sndReloadEmptyActor   = true,
        sndReloadG            = true,
        sndReloadMisfire      = true,
        sndReloadMisfireActor = true,
        sndAddCartridge       = true,
        sndOpen               = true,
        sndClose              = true,
        sndCloseEmpty         = true,
    }
end

function reload:apply()
    nanosuit_booster.abstract_booster.apply(self)

    RegisterScriptCallback("actor_on_hud_animation_play", self)
    RegisterScriptCallback("on_before_play_hud_sound", self)
end

function reload:remove()
    nanosuit_booster.abstract_booster.remove(self)

    UnregisterScriptCallback("actor_on_hud_animation_play", self)
    UnregisterScriptCallback("on_before_play_hud_sound", self)
end

function reload:actor_on_hud_animation_play(anm_table, obj)
    local anm_name = anm_table.anm_name
    if not self:is_reload_anim(anm_name) then
        return
    end

    local anm_speed = anm_table.anm_speed
    if anm_speed == 1 then
        anm_speed = self:get_config_anim_speed(obj, anm_name)
    end

    anm_table.anm_speed = anm_speed * self.m_reload_speed_coef
end

function reload:on_before_play_hud_sound(alias, parent, result)
    if not self.m_sound_aliases[alias] or not parent or parent:id() ~= AC_ID then
        return
    end

    result.frequency_mult = result.frequency_mult * self.m_reload_speed_coef
    result.delay_mult = result.delay_mult / self.m_reload_speed_coef
end

function reload:get_config_anim_speed(obj, anm_name)
    local hud_sec = ini_sys:r_string_ex(obj:section(), "hud")
    local value = hud_sec and ini_sys:r_string_ex(hud_sec, anm_name)
    if not value then
        return 1
    end

    -- anm_<name> = <hand animation>, <item animation>, <speed>, <end>
    local anm_params = str_explode(value, ",")
    local speed = anm_params[3]

    return tonumber(speed) or 1
end

function reload:is_reload_anim(anm_name)
    for _, prefix in pairs(self.m_anim_prefixes) do
        if self:has_prefix(anm_name, prefix) then
            return true
        end
    end
    return false
end

function reload:has_prefix(anm_name, prefix)
    return string.find(anm_name, prefix, 1, true) == 1
end
