-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- Imports
actor_slots_enum        = nanosuit_utils.actor_slots_enum

-- ---------------------------------------------------------------------------------------------------------------------
-- Strength mode class
-- ---------------------------------------------------------------------------------------------------------------------

class "power" (nanosuit_mode.abstract_mode)

function power:__init(core, name) super(core, name)
    -- Energy related variables
    self.m_energy_use_shoot = 4

    -- Red weave glow
    self.m_glow_settings = { r = 0.353, g = 0.027, b = 0.027, strength = 16 }

    -- Sound effects
    self.m_sounds.on = sound_object([[nanosuit\modes\power\mode_power_on]])
end

function power:apply(play_voice, play_on)
    nanosuit_mode.abstract_mode.apply(self, play_voice, play_on, "red")

    -- Register callbacks
    RegisterScriptCallback("actor_on_weapon_fired", self)

    -- Boosters
    self:apply_booster(nanosuit_booster_item_recoil.recoil, "recoil")
    self:apply_booster(nanosuit_booster_item_weight.weight, "weight")
    self:apply_booster(nanosuit_booster_item_melee.melee, "melee")
    self:apply_booster(nanosuit_booster_jump.jump, "jump")
end

function power:remove(is_destroying)
    nanosuit_mode.abstract_mode.remove(self, is_destroying)

    -- Unregister callbacks
    UnregisterScriptCallback("actor_on_weapon_fired", self)

    -- Boosters
    self:remove_booster("recoil")
    self:remove_booster("weight")
    self:remove_booster("melee")
    self:remove_booster("jump")
end

function power:actor_on_weapon_fired()
    self.m_core.m_energy:use_energy(self.m_energy_use_shoot)
end

