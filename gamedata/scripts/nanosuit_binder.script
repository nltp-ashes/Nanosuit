---                                                                                                                  ---
---    Script used to bind the Nanosuit outfits, creating the core while the suit is worn and saving its state.      ---
---                                                                                                                  ---
---    Outfits reach it through script_binding = nanosuit_binder.bind. The core is created and destroyed on the      ---
---    tick after the suit moves, and published as nanosuit_core.instance : set once it is loaded, cleared before it ---
---    is destroyed, and left alone when another suit's core has already replaced it.                                ---
---                                                                                                                  ---
---==================================================================================================================---

-- ---------------------------------------------------------------------------------------------------------------------
-- General functions
-- ---------------------------------------------------------------------------------------------------------------------

function bind(obj)
    obj:bind_object(binder(obj))
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Binder class
-- ---------------------------------------------------------------------------------------------------------------------

class "binder" (object_binder)

function binder:__init(obj) super(obj)
    nanosuit_utils.print_i("Binding object %s", obj:name())
    self.m_object = obj
    self.m_instance = nil
    self.m_loaded_storage = nil

    RegisterScriptCallback("actor_item_to_slot", self)
    RegisterScriptCallback("actor_item_to_ruck", self)
    RegisterScriptCallback("actor_on_item_drop", self)
    RegisterScriptCallback("actor_on_net_destroy", self)
end

function binder:net_destroy()
    self:destroy_instance_if_exists()
    self.m_object = nil
    self.m_instance = nil
    self.m_loaded_storage = nil

    UnregisterScriptCallback("actor_item_to_slot", self)
    UnregisterScriptCallback("actor_item_to_ruck", self)
    UnregisterScriptCallback("actor_on_item_drop", self)
    UnregisterScriptCallback("actor_on_net_destroy", self)
end

function binder:save(output_packet)
    object_binder.save(self, output_packet)

    if self.m_instance ~= nil then
        nanosuit_utils.print_i("Saving variables")
        se_save_var(self.object:id(), nil, "nanosuit_storage", self.m_instance:save())
        nanosuit_utils.print_i("Saved variables")
    end
end

function binder:load(input_packet)
    object_binder.load(self, input_packet)

    nanosuit_utils.print_i("Pre-loading variables")
    self.m_loaded_storage = se_load_var(self.object:id(), nil, "nanosuit_storage") or {}
end

function binder:create_instance_if_not_exists()
    if self.m_instance == nil then
        nanosuit_utils.print_i("Core initializing")
        self.m_instance = nanosuit_core.core()
        if self.m_loaded_storage ~= nil then
            nanosuit_utils.print_i("Loading variables")
            self.m_instance:load(self.m_loaded_storage)
            self.m_loaded_storage = nil
            nanosuit_utils.print_i("Loaded variables")
        end
        nanosuit_core.instance = self.m_instance
        nanosuit_utils.print_i("Core initialized")
    end
end

function binder:destroy_instance_if_exists()
    if self.m_instance ~= nil then
        nanosuit_utils.print_i("Core destroying")
        if nanosuit_core.instance == self.m_instance then
            nanosuit_core.instance = nil
        end
        self.m_instance:destroy()
        self.m_instance = nil
        nanosuit_utils.print_i("Core destroyed")
    end
end

function binder:actor_item_to_slot(obj)
    local obj_id = obj:id()
    nextTick(function()
        local obj_now = level.object_by_id(obj_id)
        if obj_now and obj_now:id() == self.m_object:id() then
            self:create_instance_if_not_exists()
        end
        return true
    end)
end

function binder:actor_item_to_ruck(obj)
    local obj_id = obj:id()
    nextTick(function()
        local obj_now = level.object_by_id(obj_id)
        if obj_now and obj_now:id() == self.m_object:id() then
            self:destroy_instance_if_exists()
        end
        return true
    end)
end

function binder:actor_on_item_drop(obj)
    local obj_id = obj:id()
    nextTick(function()
        local obj_now = level.object_by_id(obj_id)
        if obj_now and obj_now:id() == self.m_object:id() then
            self:destroy_instance_if_exists()
        end
        return true
    end)
end

function binder:actor_on_net_destroy()
    self:destroy_instance_if_exists()
end
