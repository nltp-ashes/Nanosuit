-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- ---------------------------------------------------------------------------------------------------------------------
-- Tactical map UI class
-- ---------------------------------------------------------------------------------------------------------------------

class "ui_tacmap" (CUIScriptWnd)

function ui_tacmap:__init(parent) super()
    -- Variables
    self.m_parent = parent

    self.m_player = vector2():set(118, 651)
    self.m_tacmap_bounds = {
        [1] = vector2():set(192, 584),
        [2] = vector2():set(50, 595),
        [3] = vector2():set(50, 685),
        [4] = vector2():set(65, 697),
        [5] = vector2():set(65, 725),
        [6] = vector2():set(176, 719),
        [7] = vector2():set(192, 700),
    }
    self.m_default_color = GetARGB(255, 255, 255, 255)
    self.m_primary_task_color = GetARGB(255, 0, 255, 0)
    self.m_secondary_task_color = GetARGB(255, 255, 255, 0)
    self.m_color_per_relation = {
        [game_object.friend] = GetARGB(255, 0, 255, 0),
        [game_object.neutral] = GetARGB(255, 255, 255, 0),
        [game_object.enemy] = GetARGB(255, 255, 0, 0)
    }
    self.m_range = 85
    self.m_scale = self:get_scale(self.m_range, self.m_player, self.m_tacmap_bounds)
    self.m_tracked_objects = {}
    self.m_task_arrows = {}

    -- Build UI
    self.m_xml = CScriptXmlInit()
    self.m_xml:ParseFile("ui_nanosuit_tacmap.xml")

    self.m_ui_background = self.m_xml:InitStatic("background", self)
    arm.scale_ui(self.m_ui_background, true, true, "left")

    self.m_ui_outline = self.m_xml:InitStatic("outline", self)
    self.m_ui_outline:SetTextureColor(self.m_parent.m_colors.background)
    arm.scale_ui(self.m_ui_outline, true, true, "left")

    self.m_ui_map = self.m_xml:InitStatic("map", self)
    self.m_ui_map:InitTexture("ui_nanosuit_tacmap_map")
    arm.scale_ui(self.m_ui_map, true, true, "left")
end

function ui_tacmap:__finalize()
end

function ui_tacmap:destroy()
end

function ui_tacmap:Update(force)
    CUIScriptWnd.Update(self)

    if self.m_parent.m_core.m_malfunctor.m_enabled then
        self.m_ui_outline:SetTextureColor(self.m_parent.m_colors.red)
    else
        self.m_ui_outline:SetTextureColor(self.m_parent.m_colors.background)
    end

    if self:is_enabled() then
        self.m_ui_map:InitTexture("ui_nanosuit_tacmap_map")
    else
        self.m_ui_map:InitTexture("ui_nanosuit_tacmap_map_malfunction")
    end

    self:update_icons()
    self:update_task_arrows()
    self:update_map()
end

function ui_tacmap:update_map()
    local shape = self:get_map_shape()
    get_hud():AddCustomShapeToRender(shape)
end

function get_level_bounds(level_name)
    return vector2():set(-481.497344,-412.284256), vector2():set(379.976288,474.479296)
end

function ui_tacmap:update_icons()
    if not self:is_enabled() then
        for obj_id, data in pairs(self.m_tracked_objects) do
            self:detach_icon(obj_id)
        end
        return
    end

    -- Iterate over all objects in proximity and refresh/track them
    level.iterate_nearest(device().cam_pos, self.m_range, function(obj)
        local hud_pos = self:pos_world_to_tacmap(obj:position())
        if (IsStalker(obj) or IsMonster(obj) or IsCar(obj)) and obj:id() ~= AC_ID and self:is_within_bounds(hud_pos) then
            if not self.m_tracked_objects[obj:id()] then
                self:attach_icon(obj:id())
            end
            self:update_icon(obj:id(), obj)
        end
    end)

    -- Update tracked objects or destroy untracked ones
    for obj_id, data in pairs(self.m_tracked_objects) do
        if data.refreshed then
            data.refreshed = false
        else
            self:detach_icon(obj_id)
        end
    end
end

function ui_tacmap:update_task_arrows()
    if not self:is_enabled() then
        for obj_id, data in pairs(self.m_task_arrows) do
            self:detach_task_arrow(obj_id)
        end
        return
    end

    -- Iterate over all task targets and refresh/track them
    local task_targets = nanosuit_utils.get_all_task_targets()
    for obj_id, obj in pairs(task_targets) do
        local hud_pos = self:pos_world_to_tacmap(obj:position())
        if (IsStalker(obj) or IsMonster(obj) or IsCar(obj)) and obj:id() ~= AC_ID and not self:is_within_bounds(hud_pos) then
            if not self.m_task_arrows[obj_id] then
                self:attach_task_arrow(obj_id)
            end
            self:update_task_arrow(obj_id, obj)
        end
    end

    -- Remove arrows for objects no longer task targets
    for obj_id, data in pairs(self.m_task_arrows) do
        if data.refreshed then
            data.refreshed = false
        else
            self:detach_task_arrow(obj_id)
        end
    end
end

function ui_tacmap:attach_task_arrow(id)
    self.m_task_arrows[id] = {}
    self.m_task_arrows[id].arrow_static = self.m_xml:InitStatic("icon", self.m_ui_map)
    self.m_task_arrows[id].arrow_static:InitTexture("ui_nanosuit_tacmap_task_arrow")
    self.m_task_arrows[id].arrow_static:SetTextureColor(nanosuit_utils.is_task_target(id, "primary") and self.m_primary_task_color or self.m_secondary_task_color)
    self.m_task_arrows[id].arrow_static:SetAutoDelete(true)
end

function ui_tacmap:detach_task_arrow(id)
    self.m_ui_map:DetachChild(self.m_task_arrows[id].arrow_static)
    self.m_task_arrows[id] = nil
end

function ui_tacmap:update_task_arrow(id, obj)
    local hud_pos = self:pos_world_to_tacmap(obj:position())
    local edge_pos, angle = self:get_bounds_intersection(hud_pos)
    if edge_pos and angle then
        arm.move_and_center_element(self.m_task_arrows[id].arrow_static, edge_pos.x, edge_pos.y)
        self.m_task_arrows[id].arrow_static:SetHeading(angle)
    end

    -- Mark as refreshed
    self.m_task_arrows[id].refreshed = true
end

function ui_tacmap:attach_icon(id)
    self.m_tracked_objects[id] = {}

    -- Main object icon
    self.m_tracked_objects[id].icon_static = self.m_xml:InitStatic("icon", self.m_ui_map)
    self.m_tracked_objects[id].icon_static:SetAutoDelete(true)

    -- Primary task icon
    self.m_tracked_objects[id].primary_task_static = self.m_xml:InitStatic("icon", self.m_ui_map)
    self.m_tracked_objects[id].primary_task_static:InitTexture("ui_nanosuit_tacmap_task_point")
    self.m_tracked_objects[id].primary_task_static:SetTextureColor(self.m_primary_task_color)
    self.m_tracked_objects[id].primary_task_static:Show(false)
    self.m_tracked_objects[id].primary_task_static:SetAutoDelete(true)

    -- Secondary task icon
    self.m_tracked_objects[id].secondary_task_static = self.m_xml:InitStatic("icon", self.m_ui_map)
    self.m_tracked_objects[id].secondary_task_static:InitTexture("ui_nanosuit_tacmap_task_point")
    self.m_tracked_objects[id].secondary_task_static:SetTextureColor(self.m_secondary_task_color)
    self.m_tracked_objects[id].secondary_task_static:Show(false)
    self.m_tracked_objects[id].secondary_task_static:SetAutoDelete(true)
end

function ui_tacmap:detach_icon(id)
    -- Detach child statics
    self.m_ui_map:DetachChild(self.m_tracked_objects[id].icon_static)
    self.m_ui_map:DetachChild(self.m_tracked_objects[id].primary_task_static)
    self.m_ui_map:DetachChild(self.m_tracked_objects[id].secondary_task_static)

    -- Clear object from registry
    self.m_tracked_objects[id] = nil
end

function ui_tacmap:update_icon(id, obj)
    -- Update coordinates
    self.m_tracked_objects[id].world_pos = obj:position()
    self.m_tracked_objects[id].world_dir = obj:direction()
    self.m_tracked_objects[id].hud_pos = self:pos_world_to_tacmap(obj:position())
    self.m_tracked_objects[id].hud_dir = self:dir_world_to_tacmap(obj:direction())

    -- Update statics
    self.m_tracked_objects[id].icon_static:SetHeading(self:should_rotate_icon(obj) and self.m_tracked_objects[id].hud_dir or 0)
    self.m_tracked_objects[id].icon_static:InitTexture(self:get_icon_texture(obj))
    self.m_tracked_objects[id].icon_static:SetTextureColor(self:get_icon_color(obj))
    self.m_tracked_objects[id].icon_static:SetWndSize(self:get_icon_size(obj))
    self.m_tracked_objects[id].primary_task_static:Show(nanosuit_utils.is_task_target(obj:id(), "primary"))
    self.m_tracked_objects[id].secondary_task_static:Show(nanosuit_utils.is_task_target(obj:id(), "secondary"))

    -- Center statics on coordinates
    arm.move_and_center_element(self.m_tracked_objects[id].icon_static, self.m_tracked_objects[id].hud_pos.x, self.m_tracked_objects[id].hud_pos.y)
    arm.move_and_center_element(self.m_tracked_objects[id].primary_task_static, self.m_tracked_objects[id].hud_pos.x, self.m_tracked_objects[id].hud_pos.y)
    arm.move_and_center_element(self.m_tracked_objects[id].secondary_task_static, self.m_tracked_objects[id].hud_pos.x, self.m_tracked_objects[id].hud_pos.y)

    -- Mark as refreshed
    self.m_tracked_objects[id].refreshed = true
end

function ui_tacmap:get_scale(range, center, bounds)
    local furthest_distance = 0

    local scale = vector2():set(device().width / 1024, device().height / 768)
    local cx = center.x * scale.x
    local cy = center.y * scale.y

    for i = 1, #bounds do
        local px = bounds[i].x * scale.x
        local py = bounds[i].y * scale.y
        local distance = nanosuit_utils.vec2_distance_to(vector2():set(cx, cy), vector2():set(px, py))

        if distance > furthest_distance then
            furthest_distance = distance
        end
    end

    return furthest_distance / range
end

function ui_tacmap:get_icon_texture(obj)
    if IsCar(obj) then
        return "ui_nanosuit_tacmap_vehicle"
    end
    if (IsStalker(obj) or IsMonster(obj)) and not obj:alive() then
        return "ui_nanosuit_tacmap_body"
    end
    return "ui_nanosuit_tacmap_object"
end

function ui_tacmap:get_icon_color(obj)
    local relation = IsStalker(obj) and obj:alive() and obj:relation(db.actor)
    if relation then
        return self.m_color_per_relation[relation]
    else
        return self.m_default_color
    end
end

function ui_tacmap:get_icon_size(obj)
    if IsCar(obj) then
        return vector2():set(15, 15)
    end
    return vector2():set(10, 10)
end

function ui_tacmap:should_rotate_icon(obj)
    if IsCar(obj) then
        return true
    end
    if (IsStalker(obj) or IsMonster(obj)) and obj:alive() then
        return true
    end
    return false
end

function ui_tacmap:is_enabled()
    return not self.m_parent.m_core.m_malfunctor.m_enabled and ui_options.get([[video/hud/show_minimap]])
end

function ui_tacmap:get_map_shape()
    -- Initialize polygon
    local shape = {
        texture = "map\\map_" .. level.name(),
        shader = "hud\\default",
        color = GetARGB(127, 255, 255, 255),
        poly = {}
    }
    for i = 1, #self.m_tacmap_bounds do
        shape.poly[i] = {}
        shape.poly[i].pt = vector2():set(0, 0)
        shape.poly[i].uv = vector2():set(0, 0)
    end

    -- Correct for aspect ratio
    local scale = vector2():set(device().width / 1024, device().height / 768)

    for i = 1, #self.m_tacmap_bounds do
        shape.poly[i].pt.x = self.m_tacmap_bounds[i].x * scale.x
        shape.poly[i].pt.y = self.m_tacmap_bounds[i].y * scale.y
    end

    -- Get world bounds (renamed for clarity)
    local world_min, world_max = get_level_bounds(level.name())
    local world_width = world_max.x - world_min.x
    local world_height = world_max.y - world_min.y

    -- Get player world position
    local player_world = device().cam_pos
    -- Get player rotation (north is up)
    local player_dir = device().cam_dir
    -- Use negative angle to fix minimap rotation direction
    local north_angle = math.atan2(player_dir.x, player_dir.z)

    -- Compute UVs: zoom and center on player, rotate according to player direction
    for i = 1, #self.m_tacmap_bounds do
        -- Flip hud_x to fix mirroring before rotation, then rotate 180°
        local hud_x = -(shape.poly[i].pt.x - self.m_player.x * scale.x)
        local hud_y = shape.poly[i].pt.y - self.m_player.y * scale.y
        -- Invert rotation direction and add 180°
        local rot_angle = -north_angle + math.pi
        local rot_x = hud_x * math.cos(rot_angle) - hud_y * math.sin(rot_angle)
        local rot_y = hud_x * math.sin(rot_angle) + hud_y * math.cos(rot_angle)
        local world_offset_x = rot_x / self.m_scale
        local world_offset_y = rot_y / self.m_scale
        local world_x = player_world.x + world_offset_x
        local world_y = player_world.z + world_offset_y
        -- Use original UV calculation
        shape.poly[i].uv.x = (world_x - world_min.x) / world_width
        shape.poly[i].uv.y = (world_max.y - world_y) / world_height
    end
    return shape
end

function ui_tacmap:pos_world_to_tacmap(pos)
    -- Translate distance from world space to tacmap space
    local distance_world = distance_2d(device().cam_pos, pos)
    local distance_tacmap = distance_world * self.m_scale

    -- Get angle from player to target in tacmap space
    local angle = self:get_heading(pos) -- angle in radians

    local scale = vector2():set(device().width / 1024, device().height / 768)

    -- Calculate the x and y coordinates on the tacmap relative to self.m_player
    local x = self.m_player.x + (distance_tacmap / scale.x) * math.sin(angle)
    local y = self.m_player.y - (distance_tacmap / scale.y) * math.cos(angle)

    local wnd_pos = self.m_ui_map:GetWndPos()

    return vector2():set(x - wnd_pos.x, y - wnd_pos.y)
end

function ui_tacmap:dir_world_to_tacmap(dir)
    -- Get device for camera info
    local player_dir = device().cam_dir

    -- Project both directions onto XZ plane
    local player_dir_xz = vector():set(player_dir.x, 0, player_dir.z):normalize()
    local obj_dir_xz = vector():set(dir.x, 0, dir.z):normalize()

    -- Compute angle between object direction and player camera direction
    local dot_product = player_dir_xz:dotproduct(obj_dir_xz)
    local angle = math.acos(clamp(dot_product, -1, 1))

    -- Determine sign using cross product (invert sign logic for HUD convention)
    local cross_product = player_dir_xz.x * obj_dir_xz.z - player_dir_xz.z * obj_dir_xz.x
    if cross_product < 0 then
        angle = -angle
    end

    return angle
end

function ui_tacmap:get_heading(pos)
    local dev = device()

    -- Get the player's position and direction
    local player_pos = dev.cam_pos
    local player_dir = dev.cam_dir

    -- Calculate the vector from the player to the target
    local to_target = vector():sub(pos, player_pos)

    -- Normalize the player's direction and the target vector on the xz plane
    local player_dir_xz = vector():set(player_dir.x, 0, player_dir.z):normalize()
    local to_target_xz = vector():set(to_target.x, 0, to_target.z):normalize()

    -- Calculate the angle using the dot product
    local dot_product = player_dir_xz:dotproduct(to_target_xz)
    local angle = math.acos(clamp(dot_product, -1, 1)) -- Clamp to avoid precision errors

    -- Determine the sign of the angle using the cross product
    local cross_product = player_dir_xz.x * to_target_xz.z - player_dir_xz.z * to_target_xz.x
    if cross_product > 0 then
        angle = -angle
    end

    return angle
end

function ui_tacmap:get_bounds_intersection(hud_pos)
    local center = self.m_player
    local bounds = self.m_tacmap_bounds
    local wnd_pos = self.m_ui_map:GetWndPos()
    local cx, cy = center.x - wnd_pos.x, center.y - wnd_pos.y
    local tx, ty = hud_pos.x, hud_pos.y
    local dx, dy = cx - tx, cy - ty
    local min_dist, ix, iy, angle = nil, nil, nil, nil
    for i = 1, #bounds do
        local j = (i % #bounds) + 1
        local x1, y1 = bounds[i].x - wnd_pos.x, bounds[i].y - wnd_pos.y
        local x2, y2 = bounds[j].x - wnd_pos.x, bounds[j].y - wnd_pos.y
        local denom = (x2 - x1) * dy - (y2 - y1) * dx
        if math.abs(denom) > 1e-6 then
            local t = ((cx - x1) * dy - (cy - y1) * dx) / denom
            local u = ((x1 - cx) * (y2 - y1) - (y1 - cy) * (x2 - x1)) / denom
            if t >= 0 and t <= 1 and u > 0 then
                local px = x1 + t * (x2 - x1)
                local py = y1 + t * (y2 - y1)
                local dist = (px - cx) ^ 2 + (py - cy) ^ 2
                if not min_dist or dist < min_dist then
                    min_dist = dist
                    ix, iy = px, py
                    angle = math.atan2(ty - cy, tx - cx) - math.pi / 2
                end
            end
        end
    end
    if ix and iy and angle then
        return vector2():set(ix, iy), -angle
    end
    return nil, nil
end

function ui_tacmap:is_within_bounds(pos)
    local bounds = self.m_tacmap_bounds
    local inside = false
    local j = #bounds

    for i = 1, #bounds do
        local vi = bounds[i]
        local vj = bounds[j]

        local wnd_pos = self.m_ui_map:GetWndPos()

        local vi_x = vi.x - wnd_pos.x
        local vi_y = vi.y - wnd_pos.y
        local vj_x = vj.x - wnd_pos.x
        local vj_y = vj.y - wnd_pos.y

        if ((vi_y > pos.y) ~= (vj_y > pos.y)) and (pos.x < (vj_x - vi_x) * (pos.y - vi_y) / (vj_y - vi_y) + vi_x) then
            inside = not inside
        end

        j = i
    end

    return inside
end