-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- ---------------------------------------------------------------------------------------------------------------------
-- Tactical map UI class
-- ---------------------------------------------------------------------------------------------------------------------

class "ui_tacmap" (CUIScriptWnd)

function ui_tacmap:__init(parent) super()
    -- Variables
    self.m_parent = parent
    self.m_last_update = 0
    self.m_update_rate = 1 / 30 * 1000 -- 30 Hz

    -- Build UI
    self.m_xml = CScriptXmlInit()
    self.m_xml:ParseFile("ui_nanosuit_tacmap.xml")

    self.m_ui_background = self.m_xml:InitStatic("background", self)
    nanosuit_utils.scale_ui_element(self.m_ui_background, true, true, "left")

    self.m_ui_outline = self.m_xml:InitStatic("outline", self)
    self.m_ui_outline:SetTextureColor(self.m_parent.m_colors.background)
    nanosuit_utils.scale_ui_element(self.m_ui_outline, true, true, "left")

    self.m_ui_visibility_bar_background = self.m_xml:InitStatic("visibility_bar_background", self)
    self.m_ui_visibility_bar_background:SetTextureColor(self.m_parent.m_colors.visibility_bg)
    nanosuit_utils.scale_ui_element(self.m_ui_visibility_bar_background, true, true, "left")

    self.m_ui_visibility_bar = self.m_xml:InitProgressBar("visibility_bar", self)
    nanosuit_utils.scale_ui_element(self.m_ui_visibility_bar, true, true, "left")
    nanosuit_utils.scale_ui_element(self.m_ui_visibility_bar:GetProgressStatic(), false, true, "left", self.m_ui_visibility_bar:GetWidth())

    self.m_ui_map = nanosuit_ui_tacmap_map.ui_tacmap_map(self)
    self.m_ui_map:Show(true)
    self:AttachChild(self.m_ui_map)
end

function ui_tacmap:__finalize()
end

function ui_tacmap:destroy()
    self.m_ui_map:destroy()
    self.m_parent = nil
end

function ui_tacmap:Update(force)
    CUIScriptWnd.Update(self)

    local tg = time_global()
    if tg - self.m_last_update < self.m_update_rate then
        return
    end
    self.m_last_update = tg

    if self.m_parent.m_core.m_malfunctor.m_enabled then
        self.m_ui_outline:SetTextureColor(self.m_parent.m_colors.red)
    else
        self.m_ui_outline:SetTextureColor(self.m_parent.m_colors.background)
    end

    self.m_ui_map:Update(force)

    self:update_visibility()
end

function ui_tacmap:update_visibility()
    if not self:is_enabled() then
        self.m_ui_visibility_bar:SetProgressPos(0)
        return
    end

    local vis = db.actor:get_actor_visibility()

    if vis < 0.25 then
        self.m_ui_visibility_bar:SetColor(self.m_parent.m_colors.visibility_very_low)
    elseif vis < 0.5 then
        self.m_ui_visibility_bar:SetColor(self.m_parent.m_colors.visibility_low)
    elseif vis < 0.75 then
        self.m_ui_visibility_bar:SetColor(self.m_parent.m_colors.visibility_high)
    else
        self.m_ui_visibility_bar:SetColor(self.m_parent.m_colors.visibility_very_high)
    end

    self.m_ui_visibility_bar:SetProgressPos(vis * 100)
end

function ui_tacmap:is_enabled()
    return not self.m_parent.m_core.m_malfunctor.m_enabled and ui_options.get([[video/hud/show_minimap]])
end
