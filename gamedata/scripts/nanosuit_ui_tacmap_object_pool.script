---                                                                                                                  ---
---    Script used to manage a pool of object to display in the Nanosuit tactical map UI.                            ---
---                                                                                                                  ---
---==================================================================================================================---

-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- ---------------------------------------------------------------------------------------------------------------------
-- Object pool class
-- ---------------------------------------------------------------------------------------------------------------------

class "ui_tacmap_object_pool"

function ui_tacmap_object_pool:__init()
    -- Variables
    self.m_validators = {
        IsStalker,
        IsMonster,
        IsInvbox,
        nanosuit_utils.is_true_car,
        nanosuit_utils.is_space_restrictor,
        nanosuit_utils.is_smart_terrain,
        nanosuit_utils.is_squad,
        nanosuit_utils.is_quest_item
    }
    self.m_pool = {}
    self.m_task_targets_cache = {}
    self.m_task_targets_cache_last_update = 0
    self.m_task_targets_cache_update_rate = 2000 -- 0.5 Hz

    -- Initialize pool
    for id, obj in pairs(gameobjects_registry) do
        self:game_object_on_net_spawn(obj)
    end

    -- Callbacks
    RegisterScriptCallback("game_object_on_net_spawn", self)
    RegisterScriptCallback("game_object_on_net_destroy", self)
end

function ui_tacmap_object_pool:__finalize()
end

function ui_tacmap_object_pool:destroy()
    UnregisterScriptCallback("game_object_on_net_spawn", self)
    UnregisterScriptCallback("game_object_on_net_destroy", self)
end

function ui_tacmap_object_pool:update()
    -- Throttle update
    local tg = time_global()
    if tg - self.m_task_targets_cache_last_update < self.m_task_targets_cache_update_rate then
        return
    end
    self.m_task_targets_cache_last_update = tg

    -- Reset cache
    self.m_task_targets_cache = {}

    -- Update cache with current task targets
    local all_targets = nanosuit_utils.get_all_task_targets()
    for tgt_id, info in pairs(all_targets) do
        self.m_task_targets_cache[tgt_id] = { tsk_id = info.tsk_id, primary = info.primary, secondary = info.secondary }
    end
end

function ui_tacmap_object_pool:game_object_on_net_spawn(obj)
    local valid = false
    for _, validator in pairs(self.m_validators) do
        if validator(obj) then
            valid = true
        end
    end
    if valid and obj:id() ~= AC_ID then
        self.m_pool[obj:id()] = obj
    end
end

function ui_tacmap_object_pool:game_object_on_net_destroy(obj)
    if self.m_pool[obj:id()] then
        self.m_pool[obj:id()] = nil
    end
end

function ui_tacmap_object_pool:iterate_relevant(range)
    local range_sqr = range * range
    local result = {}
    for id,obj in pairs(self.m_pool) do
        if obj:position():distance_to_sqr(device().cam_pos) <= range_sqr then
            result[id] = obj
        end
    end
    for id in pairs(self.m_task_targets_cache) do
        if self.m_pool[id] and not result[id] then
            result[id] = self.m_pool[id]
        end
    end
    return pairs(result)
end
