---                                                                                                                  ---
---    Script used to drive the Crysis cloak shader, a port of Crysis's CloakLayer.cfx.                              ---
---                                                                                                                  ---
---    shaders/r3/models_nanosuit_cloak.s reads the "nanosuit_cloak" shader bus lane :                               ---
---      x = refraction falloff, y = unused, z = light amount, w = cloak blend                                       ---
---                                                                                                                  ---
---    It refracts through each surface's normal map, passed as "diffuse,bump". Lua cannot read the .thm files       ---
---    naming the bumps, so <diffuse>_bump and its # error map are probed, with cloak_flat_bump as the fallback.     ---
---                                                                                                                  ---
---    The blend takes a second to engage. On uncloak it runs down by m_tail_blend before the surfaces are           ---
---    restored, which is what the suit shimmers back in with.                                                       ---
---                                                                                                                  ---
---==================================================================================================================---

-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- Constants
SHADER_BUS_LANE         = "nanosuit_cloak"
SHADER_BUS_OWNER        = "Nanosuit"
SHADER_BUS_DESCRIPTION  = "Nanosuit cloak, x = refraction falloff, y = unused, z = light amount, w = cloak blend"

-- Globals
shader_bus_token        = nil

-- ---------------------------------------------------------------------------------------------------------------------
-- General functions
-- ---------------------------------------------------------------------------------------------------------------------

function get_bus_token()
    if not shader_bus_token then
        shader_bus_token = shader_bus.try_register(SHADER_BUS_LANE, SHADER_BUS_OWNER, SHADER_BUS_DESCRIPTION)
    end
    return shader_bus_token
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Callbacks registration
-- ---------------------------------------------------------------------------------------------------------------------

function on_game_start()
    get_bus_token()
end

-- ---------------------------------------------------------------------------------------------------------------------
-- Crysis cloak shader class
-- ---------------------------------------------------------------------------------------------------------------------

class "crysis" (nanosuit_shader_cloak.abstract_cloak)

function crysis:__init(core) super(core)
    -- Constants
    self.m_blend_speed = 1
    self.m_tail_blend = 0.25
    self.m_refraction_falloff = 1

    -- Variables
    self.m_active = false
    self.m_engaged = false
    self.m_blend = 0
    self.m_restore_blend = 0
    self.m_last_update = 0
end

function crysis:destroy()
    if self.m_active then
        UnregisterScriptCallback("actor_on_update", self)
    end

    self:write(0, 0, 0)

    self.m_active = false
    self.m_engaged = false

    nanosuit_shader_cloak.abstract_cloak.destroy(self)
end

function crysis:engage()
    if not self.m_active then
        self.m_active = true
        self.m_blend = 0
        self.m_last_update = time_global()
        RegisterScriptCallback("actor_on_update", self)
    end

    self.m_engaged = true

    nanosuit_shader_cloak.abstract_cloak.engage(self)
end

function crysis:disengage()
    self.m_engaged = false
    self.m_restore_blend = math.max(self.m_blend - self.m_tail_blend, 0)

    if self.m_active and self.m_blend <= self.m_restore_blend then
        self:finish()
    end
end

function crysis:finish()
    UnregisterScriptCallback("actor_on_update", self)

    self.m_active = false

    self:write(0, 0, 0)

    nanosuit_shader_cloak.abstract_cloak.finish(self)
end

function crysis:actor_on_update()
    local tg = time_global()
    local delta = (tg - self.m_last_update) / 1000
    self.m_last_update = tg

    local direction = self.m_engaged and 1 or -1
    self.m_blend = clamp(self.m_blend + direction * delta * self.m_blend_speed, 0, 1)

    if not self.m_engaged and self.m_blend <= self.m_restore_blend then
        self:finish()
        return
    end

    self:write(self.m_refraction_falloff, db.actor:get_luminocity(), self.m_blend)
end

function crysis:write(refraction_falloff, light_amount, blend)
    shader_bus.set(get_bus_token(), refraction_falloff, 0, light_amount, blend)
end

function crysis:get_prefetch_textures()
    return {
        [[nanosuit\cloak\cloak_hex_ddn]],
        [[nanosuit\cloak\cloak_perlin]],
        [[nanosuit\cloak\cloak_noise3d]],
        [[nanosuit\cloak\cloak_sparks]],
        [[nanosuit\cloak\cloak_flat_bump]],
        [[nanosuit\cloak\cloak_flat_bump#]],
    }
end

function crysis:get_shader_texture_pair(texture)
    local diffuse = string.match(texture or "", "^[^,]*")
    local bump = nanosuit_utils.get_bump_for_texture(diffuse, [[nanosuit\cloak\cloak_flat_bump]])

    return [[models\nanosuit_cloak]], diffuse .. "," .. bump
end