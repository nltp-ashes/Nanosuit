---==================================================================================================================---

-- ---------------------------------------------------------------------------------------------------------------------
-- Constants, global variables and imported functions
-- ---------------------------------------------------------------------------------------------------------------------

-- ---------------------------------------------------------------------------------------------------------------------
-- Ammo wheel UI class
-- ---------------------------------------------------------------------------------------------------------------------

class "ui_wheel_ammo" (CUIScriptWnd)

function ui_wheel_ammo:__init(parent) super()
    -- Variables
    self.m_parent = parent

    -- Initialize ammo wheel if needed
    if not item_weapon.GUI then
        item_weapon.GUI = item_weapon.UIWheelAmmo()
    end

    -- Create outline
    item_weapon.GUI.outline = item_weapon.GUI.xml:InitStatic("wheel:background", item_weapon.GUI.dialog)
    item_weapon.GUI.outline:InitTexture("ui_nanosuit_wheel_outline")

    -- Override background
    item_weapon.GUI.background:InitTexture("ui_nanosuit_wheel_background")
    item_weapon.GUI.background:SetTextureColor(GetARGB(200, 255, 255, 255))
end

function ui_wheel_ammo:destroy()
    -- Destroy outline
    item_weapon.GUI.dialog:DetachChild(item_weapon.GUI.outline)
    item_weapon.GUI.outline = nil

    -- Reset UI
    item_weapon.GUI:InitControls()
end

function ui_wheel_ammo:Update(force)
    CUIScriptWnd.Update(self)

    if self.m_parent.m_core.m_malfunctor.m_enabled then
        item_weapon.GUI.outline:SetTextureColor(self.m_parent.m_colors.red)
    else
        item_weapon.GUI.outline:SetTextureColor(self.m_parent.m_colors.background)
    end
end
